; =====================================================================
; DSW1 - distribution switch 1
; HSRP Active for Staff (23) and ATM (46), Standby for HR (61) and IT (67).
; Routed /30 links to the ASA (primary) and the PA (bypass).
; Management runs in VRF OOB.
; =====================================================================

; Enter enable mode
wait '>'
sendln 'enable'
wait 'Password:'
sendln 'Student@s1t'

; Enter configuration mode
wait '#'
sendln 'configure terminal'
wait '#'

; Base system settings
sendln 'hostname DSW1'
wait '#'
sendln 'no ip domain lookup'
wait '#'
sendln 'ip domain name gruppesechs.sitict.net'
wait '#'
sendln 'ip routing'
wait '#'
sendln 'service password-encryption'
wait '#'
sendln 'service timestamps log datetime msec localtime'
wait '#'
sendln 'no logging console'
wait '#'
sendln 'clock timezone SGT 8 0'
wait '#'

; Login banner
sendln 'banner motd $WARNING: UNAUTHORIZED ACCESS TO GRUPPESECHS DSW1 IS PROHIBITED.$'
wait '#'

; 1. Enable secret and local admin account
sendln 'enable algorithm-type scrypt secret 4Venison2'
wait '#'
sendln 'username bigDonkBonkAdmin privilege 15 algorithm-type scrypt secret Venison2Beef'
wait '#'

; 2. Out-of-band management VRF
sendln 'vrf definition OOB'
wait '#'
sendln 'address-family ipv4'
wait '#'
sendln 'exit-address-family'
wait '#'
sendln 'exit'
wait '#'

; 3. Shut the unused rear Gi0/0 port
sendln 'interface GigabitEthernet0/0'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 4. VLANs and spanning tree (Rapid PVST+)
sendln 'vlan 23'
wait '#'
sendln 'name STAFF'
wait '#'
sendln 'vlan 46'
wait '#'
sendln 'name ATM'
wait '#'
sendln 'vlan 61'
wait '#'
sendln 'name HR'
wait '#'
sendln 'vlan 67'
wait '#'
sendln 'name IT'
wait '#'
sendln 'vlan 99'
wait '#'
sendln 'name MGMT_OOB'
wait '#'
sendln 'vlan 100'
wait '#'
sendln 'name DSW_TRANSIT'
wait '#'
sendln 'vlan 727'
wait '#'
sendln 'name UNUSED_BLACKHOLE'
wait '#'
sendln 'vlan 821'
wait '#'
sendln 'name NATIVE_TRUNK'
wait '#'
sendln 'exit'
wait '#'

sendln 'spanning-tree mode rapid-pvst'
wait '#'
sendln 'spanning-tree vlan 23,46,99,100 root primary'
wait '#'
sendln 'spanning-tree vlan 61,67 root secondary'
wait '#'

; 5. Track this switch's own link to the ASA (ping .97 over Gi1/0/11).
; If it fails, HSRP lowers DSW1's priority by 30 and the user VLANs move to DSW2.
sendln 'ip sla 10'
wait '#'
sendln 'icmp-echo 172.16.0.97 source-interface GigabitEthernet1/0/11'
wait '#'
sendln 'frequency 5'
wait '#'
sendln 'exit'
wait '#'
sendln 'ip sla schedule 10 life forever start-time now'
wait '#'
sendln 'track 10 ip sla 10 reachability'
wait '#'
sendln 'exit'
wait '#'

; 6. LACP EtherChannels: Po1-Po4 to the access switches, Po5 to DSW2
; Towards SW1 (Staff, VLAN 23)
sendln 'interface range GigabitEthernet1/0/1 - 2'
wait '#'
sendln 'description Uplink_to_SW1'
wait '#'
sendln 'channel-group 1 mode active'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Port-channel1'
wait '#'
sendln 'description Trunk_to_SW1'
wait '#'
sendln 'switchport mode trunk'
wait '#'
sendln 'switchport trunk native vlan 821'
wait '#'
sendln 'switchport trunk allowed vlan 23,99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'spanning-tree guard root'
wait '#'
sendln 'exit'
wait '#'

; Towards SW2 (ATM, VLAN 46)
sendln 'interface range GigabitEthernet1/0/3 - 4'
wait '#'
sendln 'description Uplink_to_SW2'
wait '#'
sendln 'channel-group 2 mode active'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Port-channel2'
wait '#'
sendln 'description Trunk_to_SW2'
wait '#'
sendln 'switchport mode trunk'
wait '#'
sendln 'switchport trunk native vlan 821'
wait '#'
sendln 'switchport trunk allowed vlan 46,99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'spanning-tree guard root'
wait '#'
sendln 'exit'
wait '#'

; Towards SW3 (HR, VLAN 61)
sendln 'interface range GigabitEthernet1/0/5 - 6'
wait '#'
sendln 'description Uplink_to_SW3'
wait '#'
sendln 'channel-group 3 mode active'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Port-channel3'
wait '#'
sendln 'description Trunk_to_SW3'
wait '#'
sendln 'switchport mode trunk'
wait '#'
sendln 'switchport trunk native vlan 821'
wait '#'
sendln 'switchport trunk allowed vlan 61,99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'spanning-tree guard root'
wait '#'
sendln 'exit'
wait '#'

; Towards SW4 (IT, VLAN 67)
sendln 'interface range GigabitEthernet1/0/7 - 8'
wait '#'
sendln 'description Uplink_to_SW4'
wait '#'
sendln 'channel-group 4 mode active'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Port-channel4'
wait '#'
sendln 'description Trunk_to_SW4'
wait '#'
sendln 'switchport mode trunk'
wait '#'
sendln 'switchport trunk native vlan 821'
wait '#'
sendln 'switchport trunk allowed vlan 67,99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'spanning-tree guard root'
wait '#'
sendln 'exit'
wait '#'

; Towards DSW2 (Po5 trunk)
sendln 'interface range GigabitEthernet1/0/9 - 10'
wait '#'
sendln 'description InterSwitch_Link_to_DSW2'
wait '#'
sendln 'channel-group 5 mode active'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Port-channel5'
wait '#'
sendln 'description Trunk_to_DSW2'
wait '#'
sendln 'switchport mode trunk'
wait '#'
sendln 'switchport trunk native vlan 821'
wait '#'
sendln 'switchport trunk allowed vlan 23,46,61,67,99,100'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'exit'
wait '#'

; 7. Routed /30 links to the firewalls
;   Gi1/0/11 -> ASA E1/3   172.16.0.96/30   (DSW1 .98, ASA .97)   cost 10, primary
;   Gi1/0/12 -> PA eth1/6  172.16.0.116/30  (DSW1 .118, PA .117)  cost 500, bypass
; The PA link only carries traffic if the ASA is unreachable from both DSWs.
sendln 'interface GigabitEthernet1/0/11'
wait '#'
sendln 'description Routed_Transit_to_ASA_E1_3'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'ip address 172.16.0.98 255.255.255.252'
wait '#'
sendln 'ip ospf cost 10'
wait '#'
; OSPF MD5 (must match the other end of the link)
sendln 'ip ospf authentication message-digest'
wait '#'
sendln 'ip ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface GigabitEthernet1/0/12'
wait '#'
sendln 'description Routed_Bypass_to_PA_eth1_6'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'ip address 172.16.0.118 255.255.255.252'
wait '#'
sendln 'ip ospf cost 500'
wait '#'
; OSPF MD5 (must match the other end of the link)
sendln 'ip ospf authentication message-digest'
wait '#'
sendln 'ip ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; 8. Unused ports: parked in blackhole VLAN 727 and shut down
sendln 'interface range GigabitEthernet1/0/13 - 20'
wait '#'
sendln 'description UNUSED_PORTS'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 727'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 9. Management laptop port (VLAN 99). Laptop: 172.16.0.46/28, gateway .33.
sendln 'interface GigabitEthernet1/0/21'
wait '#'
sendln 'description OOB_Mgmt_Workstation'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'spanning-tree portfast'
wait '#'
sendln 'spanning-tree bpduguard enable'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; 10. OOB management ports (VLAN 99)
sendln 'interface range GigabitEthernet1/0/22 - 24'
wait '#'
sendln 'description OOB_MGMT_DEVICES_R1_PA_PROXMOX'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'spanning-tree portfast'
wait '#'
sendln 'spanning-tree bpduguard enable'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; 11. User VLAN ACLs (applied inbound on each SVI) and the management ACL
sendln 'ip access-list extended ACL_STAFF_IN'
wait '#'
; HSRP hellos from the other DSW. Without this the final deny drops them and
; both DSWs go Active. (HR and IT don't need it: their final permit covers it.)
sendln 'permit udp 172.16.0.0 0.0.0.31 host 224.0.0.102 eq 1985'
wait '#'
; DHCP replies meant for the other DSW. Both DSWs relay, but the ASA sends all
; replies for a subnet through one DSW, so some cross the user VLAN into here.
sendln 'permit udp host 172.16.0.77 eq bootps any eq bootps'
wait '#'
sendln 'permit udp any host 255.255.255.255 eq bootps'
wait '#'
sendln 'permit udp 172.16.0.0 0.0.0.31 host 172.16.0.77 eq bootps'
wait '#'
sendln 'permit ip 172.16.0.0 0.0.0.31 host 172.16.0.75'
wait '#'
sendln 'permit ip 172.16.0.0 0.0.0.31 host 172.16.0.76'
wait '#'
sendln 'deny ip any any log'
wait '#'
sendln 'exit'
wait '#'

sendln 'ip access-list extended ACL_ATM_IN'
wait '#'
; HSRP hellos from the other DSW (see ACL_STAFF_IN)
sendln 'permit udp 172.16.0.48 0.0.0.7 host 224.0.0.102 eq 1985'
wait '#'
; DHCP replies meant for the other DSW (see ACL_STAFF_IN)
sendln 'permit udp host 172.16.0.77 eq bootps any eq bootps'
wait '#'
sendln 'permit udp any host 255.255.255.255 eq bootps'
wait '#'
sendln 'permit udp 172.16.0.48 0.0.0.7 host 172.16.0.77 eq bootps'
wait '#'
sendln 'permit ip 172.16.0.48 0.0.0.7 host 172.16.0.75'
wait '#'
sendln 'permit ip 172.16.0.48 0.0.0.7 host 172.16.0.76'
wait '#'
sendln 'deny ip any any log'
wait '#'
sendln 'exit'
wait '#'

sendln 'ip access-list extended ACL_HR_IN'
wait '#'
; DHCP replies meant for the other DSW (see ACL_STAFF_IN). HR's final permit
; doesn't cover source .77, so this is still needed.
sendln 'permit udp host 172.16.0.77 eq bootps any eq bootps'
wait '#'
sendln 'permit udp any host 255.255.255.255 eq bootps'
wait '#'
sendln 'permit udp 172.16.0.56 0.0.0.7 host 172.16.0.77 eq bootps'
wait '#'
sendln 'permit tcp 172.16.0.56 0.0.0.7 host 172.16.0.74 eq 445'
wait '#'
sendln 'permit icmp 172.16.0.56 0.0.0.7 host 172.16.0.74'
wait '#'
sendln 'permit udp 172.16.0.56 0.0.0.7 host 172.16.0.83 eq domain'
wait '#'
sendln 'permit tcp 172.16.0.56 0.0.0.7 host 172.16.0.83 eq domain'
wait '#'
sendln 'permit tcp 172.16.0.56 0.0.0.7 host 172.16.0.82 eq www'
wait '#'
sendln 'permit tcp 172.16.0.56 0.0.0.7 host 172.16.0.82 eq 443'
wait '#'
; Caching DNS VM108 (9 Nov)
sendln 'permit udp 172.16.0.56 0.0.0.7 host 172.16.0.86 eq domain'
wait '#'
sendln 'permit tcp 172.16.0.56 0.0.0.7 host 172.16.0.86 eq domain'
wait '#'
; Block HR from all other internal subnets, including pings to gateways and
; transit links. Internet traffic is allowed by the next line.
sendln 'deny ip 172.16.0.56 0.0.0.7 172.16.0.0 0.0.0.127 log'
wait '#'
sendln 'permit ip 172.16.0.56 0.0.0.7 any'
wait '#'
sendln 'exit'
wait '#'

sendln 'ip access-list extended ACL_IT_IN'
wait '#'
; DHCP replies meant for the other DSW (see ACL_STAFF_IN)
sendln 'permit udp host 172.16.0.77 eq bootps any eq bootps'
wait '#'
sendln 'permit udp any host 255.255.255.255 eq bootps'
wait '#'
sendln 'permit udp 172.16.0.64 0.0.0.7 host 172.16.0.77 eq bootps'
wait '#'
sendln 'permit udp 172.16.0.64 0.0.0.7 host 172.16.0.83 eq domain'
wait '#'
sendln 'permit tcp 172.16.0.64 0.0.0.7 host 172.16.0.83 eq domain'
wait '#'
sendln 'permit tcp 172.16.0.64 0.0.0.7 host 172.16.0.82 eq www'
wait '#'
sendln 'permit tcp 172.16.0.64 0.0.0.7 host 172.16.0.82 eq 443'
wait '#'
sendln 'permit tcp 172.16.0.64 0.0.0.7 host 172.16.0.84 eq 22'
wait '#'
sendln 'permit tcp 172.16.0.64 0.0.0.7 host 172.16.0.85 eq 22'
wait '#'
; Caching DNS VM108 (9 Nov)
sendln 'permit udp 172.16.0.64 0.0.0.7 host 172.16.0.86 eq domain'
wait '#'
sendln 'permit tcp 172.16.0.64 0.0.0.7 host 172.16.0.86 eq domain'
wait '#'
; Block IT from all other internal subnets. Internet traffic is allowed by the
; next line.
sendln 'deny ip 172.16.0.64 0.0.0.7 172.16.0.0 0.0.0.127 log'
wait '#'
sendln 'permit ip 172.16.0.64 0.0.0.7 any'
wait '#'
sendln 'exit'
wait '#'

sendln 'ip access-list standard MGMT-ONLY'
wait '#'
sendln 'permit host 172.16.0.44'
wait '#'
sendln 'permit host 172.16.0.45'
wait '#'
sendln 'deny any log'
wait '#'
sendln 'exit'
wait '#'

; 12. NetFlow v9, exported to both jump hosts over VRF OOB
sendln 'flow record bank-flow-record'
wait '#'
sendln 'description packet flow record for monitoring'
wait '#'
sendln 'match ipv4 source address'
wait '#'
sendln 'match ipv4 destination address'
wait '#'
sendln 'match transport source-port'
wait '#'
sendln 'match transport destination-port'
wait '#'
sendln 'match ipv4 protocol'
wait '#'
sendln 'match ipv4 tos'
wait '#'
sendln 'match interface input'
wait '#'
sendln 'collect interface output'
wait '#'
sendln 'collect counter bytes long'
wait '#'
sendln 'collect counter packets long'
wait '#'
sendln 'collect timestamp absolute first'
wait '#'
sendln 'collect timestamp absolute last'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow exporter bank-flow-exporter-1'
wait '#'
sendln 'description export flows to tacacs1 .44'
wait '#'
sendln 'destination 172.16.0.44 vrf OOB'
wait '#'
sendln 'source Vlan99'
wait '#'
sendln 'transport udp 2055'
wait '#'
sendln 'export-protocol netflow-v9'
wait '#'
sendln 'template data timeout 60'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow exporter bank-flow-exporter-2'
wait '#'
sendln 'description export flows to tacacs2 .45'
wait '#'
sendln 'destination 172.16.0.45 vrf OOB'
wait '#'
sendln 'source Vlan99'
wait '#'
sendln 'transport udp 2055'
wait '#'
sendln 'export-protocol netflow-v9'
wait '#'
sendln 'template data timeout 60'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow monitor bank-flow-monitor'
wait '#'
sendln 'description Redundant Dual-Collector Traffic Visibility'
wait '#'
sendln 'exporter bank-flow-exporter-1'
wait '#'
sendln 'exporter bank-flow-exporter-2'
wait '#'
sendln 'record bank-flow-record'
wait '#'
sendln 'cache timeout active 60'
wait '#'
sendln 'cache timeout inactive 15'
wait '#'
sendln 'exit'
wait '#'

; 13. SVIs and HSRP
; NetFlow on the firewall links (needs the flow monitor from section 12)
sendln 'interface range GigabitEthernet1/0/11 - 12'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'exit'
wait '#'

; DSW1 <-> DSW2 routed transit over Po5. If one DSW loses its ASA link, its
; traffic reaches the ASA through the other DSW.
sendln 'interface Vlan100'
wait '#'
sendln 'description DSW1_DSW2_Transit_over_Po5'
wait '#'
sendln 'ip address 172.16.0.125 255.255.255.252'
wait '#'
sendln 'ip ospf cost 10'
wait '#'
; OSPF MD5 (must match DSW2)
sendln 'ip ospf authentication message-digest'
wait '#'
sendln 'ip ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan23'
wait '#'
sendln 'description Staff_VLAN_Gateway'
wait '#'
sendln 'ip address 172.16.0.2 255.255.255.224'
wait '#'
; DSW1 is HSRP Active for 23/46, so it advertises them cheaper (10, DSW2 uses
; 20). Return traffic from the ASA then comes back through the same switch.
sendln 'ip ospf cost 10'
wait '#'
sendln 'ip helper-address 172.16.0.77'
wait '#'
sendln 'ip access-group ACL_STAFF_IN in'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'standby version 2'
wait '#'
sendln 'standby 23 ip 172.16.0.1'
wait '#'
sendln 'standby 23 priority 110'
wait '#'
sendln 'standby 23 preempt'
wait '#'
; HSRP MD5 (same key on both DSWs)
sendln 'standby 23 authentication md5 key-string GsHsrp2026'
wait '#'
sendln 'standby 23 track 10 decrement 30'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan46'
wait '#'
sendln 'description ATM_VLAN_Gateway'
wait '#'
sendln 'ip address 172.16.0.50 255.255.255.248'
wait '#'
sendln 'ip ospf cost 10'
wait '#'
sendln 'ip helper-address 172.16.0.77'
wait '#'
sendln 'ip access-group ACL_ATM_IN in'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'standby version 2'
wait '#'
sendln 'standby 46 ip 172.16.0.49'
wait '#'
sendln 'standby 46 priority 110'
wait '#'
sendln 'standby 46 preempt'
wait '#'
; HSRP MD5 (same key on both DSWs)
sendln 'standby 46 authentication md5 key-string GsHsrp2026'
wait '#'
sendln 'standby 46 track 10 decrement 30'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan61'
wait '#'
sendln 'description HR_VLAN_Gateway'
wait '#'
sendln 'ip address 172.16.0.58 255.255.255.248'
wait '#'
; DSW2 is Active for 61/67, so DSW1 advertises them dearer (20).
sendln 'ip ospf cost 20'
wait '#'
sendln 'ip helper-address 172.16.0.77'
wait '#'
sendln 'ip access-group ACL_HR_IN in'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'standby version 2'
wait '#'
sendln 'standby 61 ip 172.16.0.57'
wait '#'
sendln 'standby 61 priority 90'
wait '#'
sendln 'standby 61 preempt'
wait '#'
; HSRP MD5 (same key on both DSWs)
sendln 'standby 61 authentication md5 key-string GsHsrp2026'
wait '#'
sendln 'standby 61 track 10 decrement 30'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan67'
wait '#'
sendln 'description IT_VLAN_Gateway'
wait '#'
sendln 'ip address 172.16.0.66 255.255.255.248'
wait '#'
sendln 'ip ospf cost 20'
wait '#'
sendln 'ip helper-address 172.16.0.77'
wait '#'
sendln 'ip access-group ACL_IT_IN in'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'standby version 2'
wait '#'
sendln 'standby 67 ip 172.16.0.65'
wait '#'
sendln 'standby 67 priority 90'
wait '#'
sendln 'standby 67 preempt'
wait '#'
; HSRP MD5 (same key on both DSWs)
sendln 'standby 67 authentication md5 key-string GsHsrp2026'
wait '#'
sendln 'standby 67 track 10 decrement 30'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan99'
wait '#'
sendln 'description OOB_Management_SVI'
wait '#'
sendln 'vrf forwarding OOB'
sendln 'ip address 172.16.0.35 255.255.255.240'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; Default route for management traffic (via R1). Required: OSPF only runs in
; the global table, not in VRF OOB.
sendln 'ip route vrf OOB 0.0.0.0 0.0.0.0 172.16.0.33'
wait '#'

; 14. OSPF area 0
sendln 'router ospf 1'
wait '#'
sendln 'router-id 3.3.3.3'
wait '#'
sendln 'auto-cost reference-bandwidth 10000'
wait '#'
sendln 'passive-interface default'
wait '#'
sendln 'no passive-interface Vlan100'
wait '#'
sendln 'no passive-interface GigabitEthernet1/0/11'
wait '#'
sendln 'no passive-interface GigabitEthernet1/0/12'
wait '#'
sendln 'network 172.16.0.0 0.0.0.31 area 0'
wait '#'
sendln 'network 172.16.0.48 0.0.0.7 area 0'
wait '#'
sendln 'network 172.16.0.56 0.0.0.7 area 0'
wait '#'
sendln 'network 172.16.0.64 0.0.0.7 area 0'
wait '#'
; ASA link
sendln 'network 172.16.0.96 0.0.0.3 area 0'
wait '#'
; PA bypass link
sendln 'network 172.16.0.116 0.0.0.3 area 0'
wait '#'
; DSW1 <-> DSW2 transit (Vlan100)
sendln 'network 172.16.0.124 0.0.0.3 area 0'
wait '#'
sendln 'log-adjacency-changes'
wait '#'
sendln 'exit'
wait '#'

; 15. AAA (two TACACS+ servers), SSH, NTP and syslog
sendln 'aaa new-model'
wait '#'

sendln 'tacacs server TACACS1'
wait '#'
sendln 'address ipv4 172.16.0.44'
wait '#'
sendln 'key bigBoy@ServerPassword1'
wait '#'
sendln 'exit'
wait '#'

sendln 'tacacs server TACACS2'
wait '#'
sendln 'address ipv4 172.16.0.45'
wait '#'
sendln 'key bigBoy@ServerPassword2'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa group server tacacs+ tac-group'
wait '#'
sendln 'server name TACACS1'
wait '#'
sendln 'server name TACACS2'
wait '#'
sendln 'ip vrf forwarding OOB'
wait '#'
sendln 'ip tacacs source-interface Vlan99'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa authentication login default group tac-group local'
wait '#'
sendln 'aaa authentication login CONSOLE group tac-group local'
wait '#'
sendln 'aaa authorization exec default group tac-group local'
wait '#'
sendln 'aaa authorization config-commands'
wait '#'
sendln 'aaa authorization commands 15 default group tac-group local'
wait '#'
sendln 'aaa accounting exec default start-stop group tac-group'
wait '#'
sendln 'aaa accounting commands 15 default stop-only group tac-group'
wait '#'

sendln 'crypto key generate rsa modulus 2048'
wait '#'
sendln 'ip ssh version 2'
wait '#'
sendln 'ip ssh time-out 60'
wait '#'
sendln 'ip ssh authentication-retries 3'
wait '#'

sendln 'line con 0'
wait '#'
sendln 'logging synchronous'
wait '#'
sendln 'login authentication CONSOLE'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 0 2'
wait '#'
sendln 'logging synchronous'
wait '#'
sendln 'access-class MGMT-ONLY in vrf-also'
wait '#'
sendln 'transport input ssh'
wait '#'
sendln 'login authentication default'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 3 15'
wait '#'
sendln 'transport input none'
wait '#'
sendln 'exit'
wait '#'

; This image also opens vty 16-31 for SSH without the ACL, so close them.
sendln 'line vty 16 31'
wait '#'
sendln 'transport input none'
wait '#'
sendln 'exit'
wait '#'

sendln 'no ip http server'
wait '#'
sendln 'no ip http secure-server'
wait '#'

; Authenticated NTP from the jump hosts
sendln 'ntp authentication-key 1 md5 bigBoyNTPkey'
wait '#'
sendln 'ntp trusted-key 1'
wait '#'
sendln 'ntp authenticate'
wait '#'
sendln 'ntp server vrf OOB 172.16.0.44 key 1 prefer'
wait '#'
sendln 'ntp server vrf OOB 172.16.0.45 key 1'
wait '#'
sendln 'ip access-list standard NTP-SERVERS'
wait '#'
sendln 'permit host 172.16.0.44'
wait '#'
sendln 'permit host 172.16.0.45'
wait '#'
sendln 'deny any'
wait '#'
sendln 'exit'
wait '#'
sendln 'ntp access-group peer NTP-SERVERS'
wait '#'
sendln 'ntp logging'
wait '#'
sendln 'logging host 172.16.0.44 vrf OOB'
wait '#'
sendln 'logging host 172.16.0.45 vrf OOB'
wait '#'
sendln 'logging trap informational'
wait '#'
sendln 'logging buffered 64000 informational'
wait '#'
sendln 'logging monitor informational'
wait '#'

sendln 'end'
wait '#'

sendln 'enable view'
wait 'Password:'
sendln '4Venison2'
wait '#'

sendln 'configure terminal'
wait '#'

sendln 'parser view eng-view'
wait '#'
sendln 'secret engViewTriple3'
wait '#'
sendln 'commands exec include all show'
wait '#'
sendln 'commands exec include ping'
wait '#'
sendln 'commands exec include traceroute'
wait '#'
sendln 'commands exec include clear'
wait '#'
sendln 'commands configure include interface'
wait '#'
sendln 'commands interface include shutdown'
wait '#'
sendln 'commands interface include no shutdown'
wait '#'
sendln 'commands interface include switchport'
wait '#'
sendln 'commands exec include configure terminal'
wait '#'
sendln 'commands exec include configure'
wait '#'
sendln 'exit'
wait '#'

sendln 'username donkBonkEng1 view eng-view algorithm-type scrypt secret Beef2Venison'
wait '#'
sendln 'username donkBonkEng2 view eng-view algorithm-type scrypt secret Beef3Venison'
wait '#'

; End of configuration
sendln 'end'
wait '#'
