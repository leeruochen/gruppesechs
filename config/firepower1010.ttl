; =====================================================================
; ASA-1010 (Firepower 1010) - inside firewall
; Sits between the DSWs and the PA. Gateway and firewall for the internal
; servers (VLAN 69). One routed /30 to each DSW (E1/3 -> DSW1, E1/4 -> DSW2).
; =====================================================================

; Enter enable mode
wait '>'
sendln 'enable'
wait 'Password:'
sendln 'Student@s1t'

; Enter configuration mode
wait '#'
sendln 'configure terminal'
wait '#'

; Base system settings
sendln 'hostname ASA-1010'
wait '#'
sendln 'domain-name gruppesechs.sitict.net'
wait '#'
sendln 'clock timezone Singapore'
wait '#'
sendln 'banner motd WARNING: UNAUTHORIZED ACCESS TO GRUPPESECHS ASA IS PROHIBITED.'
wait '#'

; 1. Clear old AAA config and regenerate the RSA key
sendln 'clear configure aaa'
wait '#'
sendln 'crypto key zeroize rsa'
wait 'want to remove these keys?'
sendln 'yes'
wait '#'
sendln 'crypto key generate rsa modulus 2048 noconfirm'
wait '#'

; 2. Enable password and local accounts (privilege 15 admin, privilege 5 engineers)
sendln 'enable password 4Venison2'
wait '#'
sendln 'username bigDonkBonkAdmin password Venison2Beef privilege 15'
wait '#'
sendln 'username donkBonkEng1 password Beef2Venison privilege 5'
wait '#'
sendln 'username donkBonkEng2 password Beef3Venison privilege 5'
wait '#'

sendln 'privilege show level 5 mode exec command running-config'
wait '#'
sendln 'privilege show level 5 mode exec command route'
wait '#'
sendln 'privilege show level 5 mode exec command ospf'
wait '#'
sendln 'privilege show level 5 mode exec command interface'
wait '#'
sendln 'privilege show level 5 mode exec command access-list'
wait '#'
sendln 'privilege cmd level 5 mode exec command ping'
wait '#'
sendln 'privilege cmd level 5 mode exec command traceroute'
wait '#'

; 3. Remove factory defaults
sendln 'clear configure dhcpd'
wait '#'

; Remove the factory NAT. Otherwise the ASA translates all inside traffic to its
; own outside address, which has no route back. NAT is done on R1/R2 only.
sendln 'object network obj_any'
wait '#'
sendln 'no nat (any,outside) dynamic interface'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan1'
wait '#'
sendln 'no nameif'
wait '#'
sendln 'no security-level'
wait '#'
sendln 'no ip address'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 4. Routed transit interfaces
; E1/1 outside -> PA eth1/3 (172.16.0.104/30), cost 10: the normal path
sendln 'interface Ethernet1/1'
wait '#'
sendln 'description Primary_Serial_Link_to_PA440_eth1_3'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif outside'
wait '#'
sendln 'security-level 0'
wait '#'
sendln 'ip address 172.16.0.106 255.255.255.252'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 10'
wait '#'
; OSPF MD5 (must match the other end of the link)
sendln 'ospf authentication message-digest'
wait '#'
sendln 'ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'exit'
wait '#'

; PA bypass links to the routers, cost 500 (only used when the PA is down):
;   E1/2 wan-backup  -> R2 G0/1/1  172.16.0.112/30 (ASA .114, R2 .113)
;   E1/5 wan-backup2 -> R1 G0/1/1  172.16.0.108/30 (ASA .110, R1 .109)
; With the PA down the ASA prefers R1 (ISP1 default metric 10 vs 50).
sendln 'interface Ethernet1/2'
wait '#'
sendln 'description PA_Bypass_Link_to_R2_G0_1_1'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif wan-backup'
wait '#'
sendln 'security-level 0'
wait '#'
sendln 'ip address 172.16.0.114 255.255.255.252'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 500'
wait '#'
; OSPF MD5 (must match the other end of the link)
sendln 'ospf authentication message-digest'
wait '#'
sendln 'ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'exit'
wait '#'

; Inside links, one /30 per DSW:
;   E1/3 inside  -> DSW1 Gi1/0/11  172.16.0.96/30   (ASA .97,  DSW1 .98)
;   E1/4 inside2 -> DSW2 Gi1/0/11  172.16.0.100/30  (ASA .101, DSW2 .102)
; Both use the same INSIDE_IN ACL. Each DSW advertises its HSRP Active VLANs
; cheaper, so return traffic leaves on the same link it came in on.
sendln 'interface Ethernet1/3'
wait '#'
sendln 'description Inside_Transit_to_DSW1_G1_0_11'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif inside'
wait '#'
sendln 'security-level 100'
wait '#'
sendln 'ip address 172.16.0.97 255.255.255.252'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 10'
wait '#'
; OSPF MD5 (must match the other end of the link)
sendln 'ospf authentication message-digest'
wait '#'
sendln 'ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Ethernet1/4'
wait '#'
sendln 'description Inside_Transit_to_DSW2_G1_0_11'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif inside2'
wait '#'
sendln 'security-level 100'
wait '#'
sendln 'ip address 172.16.0.101 255.255.255.252'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 10'
wait '#'
; OSPF MD5 (must match the other end of the link)
sendln 'ospf authentication message-digest'
wait '#'
sendln 'ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Ethernet1/5'
wait '#'
sendln 'description PA_Bypass_Link_to_R1_G0_1_1'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif wan-backup2'
wait '#'
sendln 'security-level 0'
wait '#'
sendln 'ip address 172.16.0.110 255.255.255.252'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 500'
wait '#'
; OSPF MD5 (must match the other end of the link)
sendln 'ospf authentication message-digest'
wait '#'
sendln 'ospf message-digest-key 1 md5 GsOspf2026'
wait '#'
sendln 'exit'
wait '#'

; 5. Internal servers: E1/6 is cabled straight to the Proxmox host (VLAN 69,
; untagged). The servers use .73 as their only gateway.
sendln 'interface Ethernet1/6'
wait '#'
sendln 'description Direct_to_Supermicro_eno2_vmbr1_VLAN69'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 69'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan69'
wait '#'
sendln 'description Primary_Internal_Servers_Gateway_SVI'
wait '#'
sendln 'nameif server'
wait '#'
sendln 'security-level 60'
wait '#'
sendln 'ip address 172.16.0.73 255.255.255.248'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; Unused ports
sendln 'interface Ethernet1/7'
wait '#'
sendln 'description UNUSED_PORT'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Ethernet1/8'
wait '#'
sendln 'description UNUSED_PORT'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 6. OOB management interface (to DSW2 Gi1/0/23)
sendln 'interface Management1/1'
wait '#'
sendln 'description OOB_Management_VLAN99'
wait '#'
sendln 'management-only'
wait '#'
sendln 'nameif management'
wait '#'
sendln 'security-level 100'
wait '#'
sendln 'ip address 172.16.0.42 255.255.255.240'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; Default route for management traffic (via R1)
sendln 'route management 0.0.0.0 0.0.0.0 172.16.0.33 1'
wait '#'

; 7. OSPF area 0 on the routed transit links only.
; Expected neighbours: DSW1, DSW2, PA, R1, R2.
sendln 'router ospf 1'
wait '#'
sendln 'router-id 5.5.5.5'
wait '#'
sendln 'network 172.16.0.96 255.255.255.252 area 0'
wait '#'
sendln 'network 172.16.0.100 255.255.255.252 area 0'
wait '#'
sendln 'network 172.16.0.104 255.255.255.252 area 0'
wait '#'
sendln 'network 172.16.0.108 255.255.255.252 area 0'
wait '#'
sendln 'network 172.16.0.112 255.255.255.252 area 0'
wait '#'
sendln 'redistribute connected subnets'
wait '#'
sendln 'log-adj-changes'
wait '#'
sendln 'exit'
wait '#'

; 8. Network objects and groups
sendln 'object network STAFF'
wait '#'
sendln 'subnet 172.16.0.0 255.255.255.224'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network ATM'
wait '#'
sendln 'subnet 172.16.0.48 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network HR'
wait '#'
sendln 'subnet 172.16.0.56 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network IT'
wait '#'
sendln 'subnet 172.16.0.64 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network SERVERS'
wait '#'
sendln 'subnet 172.16.0.72 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network DMZ-SUBNET'
wait '#'
sendln 'subnet 172.16.0.80 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network INTERNAL'
wait '#'
sendln 'subnet 172.16.0.0 255.255.255.128'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network FILE-SVR'
wait '#'
sendln 'host 172.16.0.74'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network ACCT-SVR'
wait '#'
sendln 'host 172.16.0.75'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network TXN-SVR'
wait '#'
sendln 'host 172.16.0.76'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network DHCP-SVR'
wait '#'
sendln 'host 172.16.0.77'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network WEB-SVR'
wait '#'
sendln 'host 172.16.0.82'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network DNS-SVR'
wait '#'
sendln 'host 172.16.0.83'
wait '#'
sendln 'exit'
wait '#'

; Caching DNS VM108 (9 Nov)
sendln 'object network CACHE-DNS'
wait '#'
sendln 'host 172.16.0.86'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network JUMP-SVR'
wait '#'
sendln 'host 172.16.0.84'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network JUMP2-SVR'
wait '#'
sendln 'host 172.16.0.85'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network STAFF-ATM'
wait '#'
sendln 'network-object object STAFF'
wait '#'
sendln 'network-object object ATM'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network HR-IT'
wait '#'
sendln 'network-object object HR'
wait '#'
sendln 'network-object object IT'
wait '#'
sendln 'exit'
wait '#'

; DSW1 / DSW2 addresses on their ASA links
sendln 'object-group network DSWs'
wait '#'
sendln 'network-object host 172.16.0.98'
wait '#'
sendln 'network-object host 172.16.0.102'
wait '#'
sendln 'exit'
wait '#'

; Every DSW address that can relay DHCP: each VLAN SVI on both DSWs plus their
; ASA-link addresses.
sendln 'object-group network DSW-SVIS'
wait '#'
sendln 'network-object host 172.16.0.2'
wait '#'
sendln 'network-object host 172.16.0.3'
wait '#'
sendln 'network-object host 172.16.0.50'
wait '#'
sendln 'network-object host 172.16.0.51'
wait '#'
sendln 'network-object host 172.16.0.58'
wait '#'
sendln 'network-object host 172.16.0.59'
wait '#'
sendln 'network-object host 172.16.0.66'
wait '#'
sendln 'network-object host 172.16.0.67'
wait '#'
sendln 'network-object host 172.16.0.98'
wait '#'
sendln 'network-object host 172.16.0.102'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network JUMP-SVRs'
wait '#'
sendln 'network-object object JUMP-SVR'
wait '#'
sendln 'network-object object JUMP2-SVR'
wait '#'
sendln 'exit'
wait '#'

; 9. Time window for the Transactions server's internet access
sendln 'time-range TXN-WINDOW'
wait '#'
sendln 'periodic weekdays 01:00 to 03:00'
wait '#'
sendln 'exit'
wait '#'

; 10. Access lists
sendln 'access-list INSIDE_IN extended permit ospf any any'
wait '#'
; DHCP relay. The DSWs relay from each VLAN's SVI, not only their link address.
sendln 'access-list INSIDE_IN extended permit udp object-group DSW-SVIS object DHCP-SVR eq bootps'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object HR object FILE-SVR eq 445'
wait '#'
sendln 'access-list INSIDE_IN extended permit icmp object HR object FILE-SVR'
wait '#'
sendln 'access-list INSIDE_IN extended permit ip object-group STAFF-ATM object ACCT-SVR'
wait '#'
sendln 'access-list INSIDE_IN extended permit ip object-group STAFF-ATM object TXN-SVR'
wait '#'
sendln 'access-list INSIDE_IN extended permit udp object-group HR-IT object CACHE-DNS eq domain'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object-group HR-IT object CACHE-DNS eq domain'
wait '#'
sendln 'access-list INSIDE_IN extended permit udp object-group HR-IT object DNS-SVR eq domain'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object-group HR-IT object DNS-SVR eq domain'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object-group HR-IT object WEB-SVR eq www'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object-group HR-IT object WEB-SVR eq https'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object IT object-group JUMP-SVRs eq ssh'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip any object SERVERS log'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip any object DMZ-SUBNET log'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip object-group STAFF-ATM any log'
wait '#'
sendln 'access-list INSIDE_IN extended permit ip object-group HR-IT any'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip any any log'
wait '#'

; DHCP replies back to the relaying DSW SVI. Needed when the reply goes to a
; different DSW address than the request came from.
sendln 'access-list SERVER_IN extended permit udp object DHCP-SVR eq bootps object-group DSW-SVIS eq bootps'
wait '#'
; Wazuh agents on the internal servers -> manager on the jump host (tcp/1514
; data, tcp/1515 enrolment).
sendln 'access-list SERVER_IN extended permit tcp object SERVERS object JUMP-SVR range 1514 1515'
wait '#'
sendln 'access-list SERVER_IN extended deny ip object SERVERS object INTERNAL log'
wait '#'
sendln 'access-list SERVER_IN extended permit tcp object TXN-SVR any eq www time-range TXN-WINDOW'
wait '#'
sendln 'access-list SERVER_IN extended permit tcp object TXN-SVR any eq https time-range TXN-WINDOW'
wait '#'
sendln 'access-list SERVER_IN extended permit udp object TXN-SVR object DNS-SVR eq domain time-range TXN-WINDOW'
wait '#'
sendln 'access-list SERVER_IN extended deny ip any any log'
wait '#'

; Nothing inbound from the PA or the routers except OSPF; replies are allowed
; by the stateful connection table.
sendln 'access-list OUTSIDE_IN extended permit ospf any any'
wait '#'
sendln 'access-list OUTSIDE_IN extended deny ip any any log'
wait '#'

; Apply the ACLs. inside (DSW1) and inside2 (DSW2) share INSIDE_IN.
sendln 'access-group INSIDE_IN in interface inside'
wait '#'
sendln 'access-group INSIDE_IN in interface inside2'
wait '#'
sendln 'access-group SERVER_IN in interface server'
wait '#'
sendln 'access-group OUTSIDE_IN in interface outside'
wait '#'
sendln 'access-group OUTSIDE_IN in interface wan-backup'
wait '#'
sendln 'access-group OUTSIDE_IN in interface wan-backup2'
wait '#'

; 12. Stateful ICMP inspection
sendln 'policy-map global_policy'
wait '#'
sendln 'class inspection_default'
wait '#'
sendln 'inspect icmp'
wait '#'
sendln 'inspect icmp error'
wait '#'
sendln 'exit'
wait '#'
sendln 'exit'
wait '#'

; SYN flood and Slowloris limits for the internal servers: embryonic limits
; stop SYN floods, per-client-max stops Slowloris.
sendln 'access-list MPF_INTERNAL_SVRS extended permit tcp any object SERVERS'
wait '#'
sendln 'class-map CM_SVR_PROTECT'
wait '#'
sendln 'match access-list MPF_INTERNAL_SVRS'
wait '#'
sendln 'exit'
wait '#'
sendln 'policy-map PM_INSIDE_PROTECT'
wait '#'
sendln 'class CM_SVR_PROTECT'
wait '#'
sendln 'set connection conn-max 500 embryonic-conn-max 50 per-client-max 50 per-client-embryonic-max 10'
wait '#'
sendln 'set connection timeout embryonic 0:00:15'
wait '#'
sendln 'exit'
wait '#'
sendln 'exit'
wait '#'
sendln 'service-policy PM_INSIDE_PROTECT interface inside'
wait '#'
sendln 'service-policy PM_INSIDE_PROTECT interface inside2'
wait '#'
sendln 'threat-detection basic-threat'
wait '#'
sendln 'threat-detection statistics tcp-intercept'
wait '#'

; 13. AAA (two TACACS+ servers), SSH, NTP and syslog, all over the management
; interface
sendln 'aaa-server TACACS protocol tacacs+'
wait '#'
sendln 'aaa-server TACACS (management) host 172.16.0.44'
wait '#'
sendln 'key bigBoy@ServerPassword1'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa-server TACACS (management) host 172.16.0.45'
wait '#'
sendln 'key bigBoy@ServerPassword2'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa authentication ssh console TACACS LOCAL'
wait '#'
sendln 'aaa authentication serial console TACACS LOCAL'
wait '#'
sendln 'aaa authentication enable console TACACS LOCAL'
wait '#'
sendln 'aaa local authentication attempts max-fail 5'
wait '#'
sendln 'aaa authorization exec authentication-server auto-enable'
wait '#'
sendln 'aaa authorization command TACACS LOCAL'
wait '#'
sendln 'aaa accounting command TACACS'
wait '#'

sendln 'ssh 172.16.0.44 255.255.255.255 management'
wait '#'
sendln 'ssh 172.16.0.45 255.255.255.255 management'
wait '#'
sendln 'ssh timeout 10'
wait '#'
sendln 'no http server enable'
wait '#'

; Authenticated NTP from the jump hosts
sendln 'ntp authentication-key 1 md5 bigBoyNTPkey'
wait '#'
sendln 'ntp trusted-key 1'
wait '#'
sendln 'ntp authenticate'
wait '#'
sendln 'ntp server 172.16.0.44 key 1 source management prefer'
wait '#'
sendln 'ntp server 172.16.0.45 key 1 source management'
wait '#'

sendln 'logging enable'
wait '#'
sendln 'logging timestamp'
wait '#'
sendln 'logging trap informational'
wait '#'
; Keep a copy of the logs in RAM. Use 'terminal monitor' to see them over SSH.
sendln 'logging buffered informational'
wait '#'
sendln 'logging monitor informational'
wait '#'
sendln 'logging host management 172.16.0.44'
wait '#'
sendln 'logging host management 172.16.0.45'
wait '#'

; End of configuration
sendln 'end'
wait '#'
