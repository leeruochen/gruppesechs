; =====================================================================
; PA-440 - perimeter firewall (gruppesechs.sitict.net)
; Sits between the ASA and the routers, and is the gateway for the DMZ.
; =====================================================================

; Enter configuration mode
wait '>'
sendln 'configure'
wait '[edit]'

; ---------------------------------------------------------------------
; 1. Remove the factory defaults
; ---------------------------------------------------------------------
; Factory security rule
sendln 'delete rulebase security rules rule1'
wait '[edit]'

; Factory virtual wire and its zones
sendln 'delete network virtual-wire default-vwire'
wait '[edit]'
sendln 'delete zone trust'
wait '[edit]'
sendln 'delete zone untrust'
wait '[edit]'

; Leftover virtual-wire / layer 3 bindings on the ports
sendln 'delete network interface ethernet ethernet1/1 virtual-wire'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/2 virtual-wire'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/2 layer3'
wait '[edit]'
sendln 'delete network virtual-router default interface ethernet1/1'
wait '[edit]'
sendln 'delete network virtual-router default interface ethernet1/2'
wait '[edit]'

; ---------------------------------------------------------------------
; 2. System settings and admin accounts
; ---------------------------------------------------------------------
sendln 'set deviceconfig system hostname PA-440'
wait '[edit]'
sendln 'set deviceconfig system domain gruppesechs.sitict.net'
wait '[edit]'
; Must be SGT: the TXN-WINDOW schedule runs on the PA's local time.
sendln 'set deviceconfig system timezone Asia/Singapore'
wait '[edit]'
; Hostname format in syslog (what Wazuh decodes)
sendln 'set deviceconfig setting management hostname-type-in-syslog FQDN'
wait '[edit]'
sendln 'set deviceconfig system login-banner "WARNING: UNAUTHORIZED ACCESS TO GRUPPESECHS PA-440 IS PROHIBITED."'
wait '[edit]'

; OOB management port.
sendln 'set deviceconfig system type static ip-address 172.16.0.41 netmask 255.255.255.240 default-gateway 172.16.0.33'
wait '[edit]'
sendln 'set deviceconfig system service disable-telnet yes disable-http yes disable-ssh no disable-https no'
wait '[edit]'

; Management access only from the two jump hosts
sendln 'set deviceconfig system permitted-ip 172.16.0.44/32'
wait '[edit]'
sendln 'set deviceconfig system permitted-ip 172.16.0.45/32'
wait '[edit]'

; Lock an admin out for 5 minutes after 5 failed logins; 10-minute idle timeout
sendln 'set deviceconfig setting management admin-lockout failed-attempts 5 lockout-time 5'
wait '[edit]'
sendln 'set deviceconfig setting management idle-timeout 10'
wait '[edit]'

; NTP from the jump hosts
sendln 'set deviceconfig system ntp-servers primary-ntp-server ntp-server-address 172.16.0.44'
wait '[edit]'
sendln 'set deviceconfig system ntp-servers secondary-ntp-server ntp-server-address 172.16.0.45'
wait '[edit]'
; NTP authentication
sendln 'set deviceconfig system ntp-servers primary-ntp-server authentication-type symmetric-key key-id 1 algorithm md5 authentication-key bigBoyNTPkey'
wait '[edit]'
sendln 'set deviceconfig system ntp-servers secondary-ntp-server authentication-type symmetric-key key-id 1 algorithm md5 authentication-key bigBoyNTPkey'
wait '[edit]'

; Local accounts: admin (superuser) and engineers (read-only superreader)
sendln 'set mgt-config users bigDonkBonkAdmin permissions role-based superuser yes'
wait '[edit]'
sendln 'set mgt-config users bigDonkBonkAdmin password'
wait 'Enter password   :'
sendln 'Venison2Beef'
wait 'Confirm password :'
sendln 'Venison2Beef'
wait '[edit]'

sendln 'set mgt-config users donkBonkEng1 permissions role-based superreader yes'
wait '[edit]'
sendln 'set mgt-config users donkBonkEng1 password'
wait 'Enter password   :'
sendln 'Beef2Venison'
wait 'Confirm password :'
sendln 'Beef2Venison'
wait '[edit]'

sendln 'set mgt-config users donkBonkEng2 permissions role-based superreader yes'
wait '[edit]'
sendln 'set mgt-config users donkBonkEng2 password'
wait 'Enter password   :'
sendln 'Beef3Venison'
wait 'Confirm password :'
sendln 'Beef3Venison'
wait '[edit]'

; ---------------------------------------------------------------------
; 3. Interface management profile (data interfaces answer ping only)
; ---------------------------------------------------------------------
sendln 'set network profiles interface-management-profile PING-ONLY ping yes'
wait '[edit]'

; ---------------------------------------------------------------------
; 4. Interfaces
; ---------------------------------------------------------------------
; eth1/1 unused
sendln 'set network interface ethernet ethernet1/1 link-state down'
wait '[edit]'

; eth1/3 -> ASA E1/1 (172.16.0.104/30): the normal path
sendln 'set network interface ethernet ethernet1/3 layer3 ip 172.16.0.105/30'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/3 layer3 interface-management-profile PING-ONLY'
wait '[edit]'

; Layer 2 ports: eth1/2 and eth1/5 to the routers (VLAN 10), eth1/4 to the
; Proxmox host (DMZ, untagged)
sendln 'set network interface ethernet ethernet1/2 layer2 lldp enable no'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/4 layer2 lldp enable no'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/5 layer2 lldp enable no'
wait '[edit]'

; ASA bypass links, one routed /30 per DSW:
;   eth1/6 -> DSW1 Gi1/0/12  172.16.0.116/30  (PA .117, DSW1 .118)
;   eth1/7 -> DSW2 Gi1/0/12  172.16.0.120/30  (PA .121, DSW2 .122)
; OSPF cost 500 keeps them idle unless the ASA is unreachable from both DSWs.
sendln 'set network interface ethernet ethernet1/6 link-state auto'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/6 layer3 ip 172.16.0.117/30'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/6 layer3 interface-management-profile PING-ONLY'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/7 link-state auto'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/7 layer3 ip 172.16.0.121/30'
wait '[edit]'
sendln 'set network interface ethernet ethernet1/7 layer3 interface-management-profile PING-ONLY'
wait '[edit]'

; eth1/8 unused
sendln 'set network interface ethernet ethernet1/8 link-state down'
wait '[edit]'

; VLAN interfaces: vlan.10 to the routers, vlan.92 is the DMZ gateway
sendln 'set network interface vlan units vlan.10 ip 172.16.0.92/29'
wait '[edit]'
sendln 'set network interface vlan units vlan.10 interface-management-profile PING-ONLY'
wait '[edit]'

sendln 'set network interface vlan units vlan.92 ip 172.16.0.81/29'
wait '[edit]'
sendln 'set network interface vlan units vlan.92 interface-management-profile PING-ONLY'
wait '[edit]'

; VLAN
sendln 'set network vlan OUTSIDE interface [ ethernet1/2 ethernet1/5 ]'
wait '[edit]'
sendln 'set network vlan OUTSIDE virtual-interface interface vlan.10'
wait '[edit]'

sendln 'set network vlan VL-DMZ interface [ ethernet1/4 ]'
wait '[edit]'
sendln 'set network vlan VL-DMZ virtual-interface interface vlan.92'
wait '[edit]'

; ---------------------------------------------------------------------
; 5. Security zones
; ---------------------------------------------------------------------
sendln 'set zone outside network layer3 vlan.10'
wait '[edit]'
sendln 'set zone outside-l2 network layer2 [ ethernet1/2 ethernet1/5 ]'
wait '[edit]'

; The bypass links are in 'inside' too, so users get the same rules whichever
; way they arrive.
sendln 'set zone inside network layer3 [ ethernet1/3 ethernet1/6 ethernet1/7 ]'
wait '[edit]'

sendln 'set zone dmz network layer3 vlan.92'
wait '[edit]'
sendln 'set zone dmz-l2 network layer2 ethernet1/4'
wait '[edit]'

; Zone protection on 'outside': SYN cookies, UDP/ICMP flood limits, scanners
; blocked for 300 s (8001 TCP port scan, 8002 host sweep, 8003 UDP scan),
; spoofed sources dropped. Rates count new sessions only, so replies to HR/IT
; aren't affected.
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE flood tcp-syn enable yes'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE flood tcp-syn syn-cookies alarm-rate 100 activate-rate 200 maximal-rate 2000'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE flood udp enable yes'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE flood udp red alarm-rate 500 activate-rate 1000 maximal-rate 5000'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE flood icmp enable yes'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE flood icmp red alarm-rate 50 activate-rate 100 maximal-rate 500'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE scan 8001 action block-ip track-by source duration 300'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE scan 8001 interval 2 threshold 100'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE scan 8002 action block-ip track-by source duration 300'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE scan 8002 interval 10 threshold 100'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE scan 8003 action block-ip track-by source duration 300'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE scan 8003 interval 2 threshold 100'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-OUTSIDE discard-ip-spoof yes'
wait '[edit]'
sendln 'set zone outside network zone-protection-profile ZP-OUTSIDE'
wait '[edit]'

; Zone protection on 'dmz': limits what a compromised server can do
sendln 'set network profiles zone-protection-profile ZP-DMZ discard-ip-spoof yes'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-DMZ scan 8001 action block-ip track-by source duration 300'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-DMZ scan 8001 interval 2 threshold 100'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-DMZ scan 8002 action block-ip track-by source duration 300'
wait '[edit]'
sendln 'set network profiles zone-protection-profile ZP-DMZ scan 8002 interval 10 threshold 100'
wait '[edit]'
sendln 'set zone dmz network zone-protection-profile ZP-DMZ'
wait '[edit]'

; ---------------------------------------------------------------------
; 6. Virtual router and OSPF
; ---------------------------------------------------------------------
; The PA learns the internal server subnet from the ASA, so traffic to those
; servers always passes through the ASA.
sendln 'set network virtual-router default interface [ ethernet1/3 ethernet1/6 ethernet1/7 vlan.10 vlan.92 ]'
wait '[edit]'
sendln 'set network virtual-router default protocol ospf enable yes'
wait '[edit]'
sendln 'set network virtual-router default protocol ospf router-id 6.6.6.6'
wait '[edit]'
; Required: PAN-OS ignores OSPF default routes unless told otherwise. The PA's
; only default comes from R1/R2 via OSPF.
sendln 'set network virtual-router default protocol ospf reject-default-route no'
wait '[edit]'

; OSPF interfaces: ASA link (cost 10)
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface ethernet1/3 enable yes passive no metric 10'
wait '[edit]'

; DMZ: passive, so the subnet is advertised but a DMZ server can't form an
; adjacency and inject routes
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface vlan.92 enable yes passive yes metric 10'
wait '[edit]'

; Router VLAN (cost 10)
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface vlan.10 enable yes passive no metric 10'
wait '[edit]'

; DSW bypass links (cost 500)
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface ethernet1/6 enable yes passive no metric 500'
wait '[edit]'
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface ethernet1/7 enable yes passive no metric 500'
wait '[edit]'

; OSPF MD5 on every active link (same key everywhere). No static default route:
; it comes from OSPF (R1 normally, R2 if R1 or ISP1 is down).
sendln 'set network virtual-router default protocol ospf auth-profile OSPF-MD5 md5 1 key GsOspf2026 preferred yes'
wait '[edit]'
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface ethernet1/3 authentication OSPF-MD5'
wait '[edit]'
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface ethernet1/6 authentication OSPF-MD5'
wait '[edit]'
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface ethernet1/7 authentication OSPF-MD5'
wait '[edit]'
sendln 'set network virtual-router default protocol ospf area 0.0.0.0 interface vlan.10 authentication OSPF-MD5'
wait '[edit]'

; ---------------------------------------------------------------------
; 7. Address objects and groups
; ---------------------------------------------------------------------
sendln 'set address STAFF ip-netmask 172.16.0.0/27'
wait '[edit]'
sendln 'set address ATM ip-netmask 172.16.0.48/29'
wait '[edit]'
sendln 'set address HR-NET ip-netmask 172.16.0.56/29'
wait '[edit]'
sendln 'set address IT-NET ip-netmask 172.16.0.64/29'
wait '[edit]'
sendln 'set address SERVERS ip-netmask 172.16.0.72/29'
wait '[edit]'
sendln 'set address DMZ-SUBNET ip-netmask 172.16.0.80/29'
wait '[edit]'

; Internal servers
sendln 'set address FILE-SVR ip-netmask 172.16.0.74/32'
wait '[edit]'
sendln 'set address ACCT-SVR ip-netmask 172.16.0.75/32'
wait '[edit]'
sendln 'set address TXN-SVR ip-netmask 172.16.0.76/32'
wait '[edit]'
sendln 'set address DHCP-SVR ip-netmask 172.16.0.77/32'
wait '[edit]'

; DMZ servers
sendln 'set address WEB-SVR ip-netmask 172.16.0.82/32'
wait '[edit]'
sendln 'set address DNS-SVR ip-netmask 172.16.0.83/32'
wait '[edit]'
sendln 'set address JUMP-SVR ip-netmask 172.16.0.84/32'
wait '[edit]'
sendln 'set address JUMP2-SVR ip-netmask 172.16.0.85/32'
wait '[edit]'
; Caching DNS VM108 (9 Nov)
sendln 'set address CACHE-DNS ip-netmask 172.16.0.86/32'
wait '[edit]'

; Upstream resolvers for the DMZ DNS server
sendln 'set address DNS-FORWARDERS-1 ip-netmask 8.8.8.8/32'
wait '[edit]'
sendln 'set address DNS-FORWARDERS-2 ip-netmask 1.1.1.1/32'
wait '[edit]'
; Lab DNS server. VM101 asks it first, because other racks' names only exist there.
sendln 'set address ICT-DNS ip-netmask 172.18.4.32/32'
wait '[edit]'

; Address groups
sendln 'set address-group STAFF-ATM static [ STAFF ATM ]'
wait '[edit]'
sendln 'set address-group HR-IT static [ HR-NET IT-NET ]'
wait '[edit]'
sendln 'set address-group INTERNET-USERS static [ HR-NET IT-NET ]'
wait '[edit]'

; Transactions server internet window (must match the ASA's time-range)
sendln 'set schedule TXN-WINDOW schedule-type recurring weekly monday 01:00-03:00 tuesday 01:00-03:00 wednesday 01:00-03:00 thursday 01:00-03:00 friday 01:00-03:00'
wait '[edit]'

; ---------------------------------------------------------------------
; 8. Security rules
; ---------------------------------------------------------------------
; OSPF between zones must be allowed explicitly
sendln 'set rulebase security rules ALLOW-OSPF from [ outside inside ] to [ outside inside ] source any destination any source-user any category any application ospf service any action allow log-end no'
wait '[edit]'

; Inbound from the internet to the DMZ servers (real addresses; R1/R2 have
; already translated the public IP and port)
sendln 'set rulebase security rules INBOUND-WEB from outside to dmz source any destination WEB-SVR source-user any category any application [ web-browsing ssl ] service application-default action allow log-end yes'
wait '[edit]'
sendln 'set rulebase security rules INBOUND-DNS from outside to dmz source any destination DNS-SVR source-user any category any application dns service application-default action allow log-end yes'
wait '[edit]'
sendln 'set rulebase security rules JUMP-SSH-IN from outside to dmz source any destination JUMP-SVR source-user any category any application ssh service application-default action allow log-end yes'
wait '[edit]'

; Users to the DMZ
sendln 'set rulebase security rules INTERNAL-TO-DNS from inside to dmz source INTERNET-USERS destination [ DNS-SVR CACHE-DNS ] source-user any category any application dns service application-default action allow log-end yes'
wait '[edit]'
sendln 'set rulebase security rules INTERNAL-TO-WEB from inside to dmz source INTERNET-USERS destination WEB-SVR source-user any category any application [ web-browsing ssl ] service application-default action allow log-end yes'
wait '[edit]'
sendln 'set rulebase security rules IT-TO-JUMP-SSH from inside to dmz source IT-NET destination [ JUMP-SVR JUMP2-SVR ] source-user any category any application ssh service application-default action allow log-end yes'
wait '[edit]'

; HR and IT get full internet access (any application). Internal and DMZ access
; is controlled by the DSW ACLs, the ASA and the rules above.
sendln 'set rulebase security rules HR-IT-INTERNET from inside to outside source INTERNET-USERS destination any source-user any category any application any service any action allow log-end yes'
wait '[edit]'
sendln 'set rulebase security rules TXN-INTERNET-TIMED from inside to [ outside dmz ] source TXN-SVR destination any source-user any category any application [ web-browsing ssl dns ] service application-default schedule TXN-WINDOW action allow log-end yes'
wait '[edit]'
sendln 'set rulebase security rules DMZ-OUTBOUND-NTP from dmz to outside source [ JUMP-SVR JUMP2-SVR ] destination any source-user any category any application [ ntp dns ] service application-default action allow log-end yes'
wait '[edit]'

; DMZ DNS server forwarding queries to the upstream resolvers
sendln 'set rulebase security rules DNS-SVR-FORWARD from dmz to outside source [ DNS-SVR CACHE-DNS ] destination [ ICT-DNS DNS-FORWARDERS-1 DNS-FORWARDERS-2 ] source-user any category any application dns service application-default action allow log-end yes'
wait '[edit]'

; DoS protection for the DMZ servers: at most 50 sessions per source IP (Slowloris)
sendln 'set profiles dos-protection DOS-PER-CLIENT type classified'
wait '[edit]'
sendln 'set profiles dos-protection DOS-PER-CLIENT resource sessions enabled yes'
wait '[edit]'
sendln 'set profiles dos-protection DOS-PER-CLIENT resource sessions max-concurrent-limit 50'
wait '[edit]'
sendln 'set rulebase dos rules DOS-DMZ-SERVERS from zone outside'
wait '[edit]'
sendln 'set rulebase dos rules DOS-DMZ-SERVERS to zone dmz'
wait '[edit]'
sendln 'set rulebase dos rules DOS-DMZ-SERVERS source any destination [ WEB-SVR DNS-SVR JUMP-SVR ] source-user any service any'
wait '[edit]'
sendln 'set rulebase dos rules DOS-DMZ-SERVERS action protect'
wait '[edit]'
sendln 'set rulebase dos rules DOS-DMZ-SERVERS protection classified profile DOS-PER-CLIENT classification-criteria address source-ip-only'
wait '[edit]'

; Wazuh agents on the internal servers -> manager on the jump host (tcp/1514
; data, tcp/1515 enrolment). Must come before DENY-ALL.
sendln 'set service WAZUH-AGENT protocol tcp port 1514-1515'
wait '[edit]'
sendln 'set rulebase security rules WAZUH-AGENTS from inside to dmz source SERVERS destination JUMP-SVR source-user any category any application any service WAZUH-AGENT action allow log-end yes log-setting LFP-WAZUH'
wait '[edit]'

; Deny and log everything else between zones
sendln 'set rulebase security rules DENY-ALL rule-type interzone from any to any source any destination any source-user any category any application any service any action deny log-end yes'
wait '[edit]'

; ---------------------------------------------------------------------
; 9. TACACS+, admin authentication and syslog
; ---------------------------------------------------------------------
sendln 'set shared server-profile tacplus TACACS server JUMP address 172.16.0.44 secret bigBoy@ServerPassword1'
wait '[edit]'
sendln 'set shared server-profile tacplus TACACS server JUMP2 address 172.16.0.45 secret bigBoy@ServerPassword2'
wait '[edit]'
sendln 'set shared server-profile tacplus TACACS protocol PAP'
wait '[edit]'
sendln 'set shared server-profile tacplus TACACS timeout 3'
wait '[edit]'
sendln 'set shared server-profile tacplus TACACS retry 2'
wait '[edit]'

; Admin logins go to TACACS first; the local accounts are used only when both
; TACACS servers are unreachable.
sendln 'set shared authentication-profile AUTH-TACACS method tacplus server-profile TACACS'
wait '[edit]'
sendln 'set shared authentication-profile AUTH-TACACS allow-list all'
wait '[edit]'
sendln 'set shared authentication-profile AUTH-LOCAL method local-database'
wait '[edit]'
sendln 'set shared authentication-profile AUTH-LOCAL allow-list all'
wait '[edit]'
sendln 'set shared authentication-sequence SEQ-ADMIN authentication-profiles [ AUTH-TACACS AUTH-LOCAL ]'
wait '[edit]'
sendln 'set deviceconfig system authentication-profile SEQ-ADMIN'
wait '[edit]'

sendln 'set shared log-settings syslog SYSLOG-JUMP server JUMP server 172.16.0.44 transport UDP port 514 format BSD facility LOG_USER'
wait '[edit]'
sendln 'set shared log-settings syslog SYSLOG-JUMP server JUMP2 server 172.16.0.45 transport UDP port 514 format BSD facility LOG_USER'
wait '[edit]'

; ---------------------------------------------------------------------
; 10. Log forwarding to Wazuh. SYSLOG-JUMP above is only the destination;
;     nothing is sent until these profiles and match lists are attached.
; ---------------------------------------------------------------------
; Traffic and threat logs
sendln 'set shared log-settings profiles LFP-WAZUH match-list ML-TRAFFIC log-type traffic filter "All Logs" send-syslog SYSLOG-JUMP'
wait '[edit]'
sendln 'set shared log-settings profiles LFP-WAZUH match-list ML-THREAT log-type threat filter "All Logs" send-syslog SYSLOG-JUMP'
wait '[edit]'
; System logs (incl. admin login failures and lockouts) and config logs
sendln 'set shared log-settings system match-list ML-SYS filter "All Logs" send-syslog SYSLOG-JUMP'
wait '[edit]'
sendln 'set shared log-settings config match-list ML-CFG filter "All Logs" send-syslog SYSLOG-JUMP'
wait '[edit]'
sendln 'set rulebase security rules INBOUND-WEB log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules INBOUND-DNS log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules JUMP-SSH-IN log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules INTERNAL-TO-DNS log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules INTERNAL-TO-WEB log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules IT-TO-JUMP-SSH log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules HR-IT-INTERNET log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules TXN-INTERNET-TIMED log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules DMZ-OUTBOUND-NTP log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules DNS-SVR-FORWARD log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set rulebase security rules DENY-ALL log-setting LFP-WAZUH'
wait '[edit]'
; DoS rule and zone protection logs
sendln 'set rulebase dos rules DOS-DMZ-SERVERS log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set zone outside network log-setting LFP-WAZUH'
wait '[edit]'
sendln 'set zone dmz network log-setting LFP-WAZUH'
wait '[edit]'

; ---------------------------------------------------------------------
; 11. Commit
; ---------------------------------------------------------------------
sendln 'commit'
wait 'Configuration committed successfully'
sendln 'exit'
