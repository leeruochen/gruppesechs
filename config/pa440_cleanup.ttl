; =====================================================================
; Tera Term Macro Script: PA-440 RULEBASE CLEANUP (Clean Slate)
; Purpose: Delete ALL security + NAT rules by name so a subsequent
;          clean run of pa440.ttl lands on a blank, correctly-ordered
;          rulebase (set-based config is additive, so stale rules from
;          prior runs must be explicitly removed).
;
; Notes:
;  - Waits on '[edit]' (the PAN-OS config-mode marker printed after each
;    command) instead of '#', which also appears inside the login banner
;    and mid-output and caused premature sends / command collisions.
;  - 'delete rulebase security rules <name>' on a non-existent rule is
;    harmless (PAN-OS reports it and continues), so this is safe to run
;    even if some rules were already removed manually.
;  - Scope: deletes security rules, NAT rules, address-groups, address
;    objects, and the custom service objects that pa440.ttl recreates.
;    This clears stale members (e.g. DSW1-IP/DSW2-IP) that accumulate from
;    PAN-OS additive set-merges. Mgmt/AAA are left intact.
;  - Section 7 removes the pre-5-Nov interface design (vlan.100 L2 bypass,
;    vlan.69 server backup and their zones) so pa440.ttl can make eth1/6/7
;    routed /30s. Safe to re-run once done: deleting a missing object is
;    harmless.
;  - Deletion order matters: rules first (they reference objects), then
;    address-groups (they reference addresses), then addresses and services.
; =====================================================================

; Connect and enter configuration mode
wait '>'
sendln 'configure'
wait '[edit]'

; ---------------------------------------------------------------------
; 1. DELETE SECURITY RULES (current macro rules)
; ---------------------------------------------------------------------
sendln 'delete rulebase security rules INBOUND-WEB'
wait '[edit]'
sendln 'delete rulebase security rules INBOUND-DNS'
wait '[edit]'
sendln 'delete rulebase security rules JUMP-SSH-IN'
wait '[edit]'
sendln 'delete rulebase security rules INTERNAL-TO-DNS'
wait '[edit]'
sendln 'delete rulebase security rules INTERNAL-TO-WEB'
wait '[edit]'
sendln 'delete rulebase security rules IT-TO-JUMP-SSH'
wait '[edit]'
sendln 'delete rulebase security rules PTSO-HR-TO-FILE'
wait '[edit]'
sendln 'delete rulebase security rules PTSO-STAFF-ATM-SVR'
wait '[edit]'
sendln 'delete rulebase security rules HR-IT-INTERNET'
wait '[edit]'
sendln 'delete rulebase security rules TXN-INTERNET-TIMED'
wait '[edit]'
sendln 'delete rulebase security rules DMZ-OUTBOUND-NTP'
wait '[edit]'
sendln 'delete rulebase security rules DENY-ALL'
wait '[edit]'

; ---------------------------------------------------------------------
; 2. DELETE SECURITY RULES (stale rules from prior macro versions)
; ---------------------------------------------------------------------
sendln 'delete rulebase security rules ALLOW-OSPF'
wait '[edit]'
sendln 'delete rulebase security rules DMZ-WEB-IN'
wait '[edit]'
sendln 'delete rulebase security rules DMZ-DNS-IN'
wait '[edit]'
sendln 'delete rulebase security rules PTSO-DHCP-RELAY'
wait '[edit]'
sendln 'delete rulebase security rules DNS-SVR-FORWARD'
wait '[edit]'
; Temporary server maintenance rules (HANDOVER.md 8.4), in case they were left in:
sendln 'delete rulebase security rules TEMP-SVR-UPDATES'
wait '[edit]'

; ---------------------------------------------------------------------
; 3. DELETE NAT RULES
; ---------------------------------------------------------------------
sendln 'delete rulebase nat rules NAT-WEB'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-WEB-HTTPS'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-DNS'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-JUMP-SSH'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-OUTBOUND'
wait '[edit]'
sendln 'delete rulebase nat rules TEMP-SVR-NAT'
wait '[edit]'
; NAT moved to R1/R2 on 5 Nov: pa440.ttl no longer recreates any NAT rules.

; ---------------------------------------------------------------------
; 4. DELETE ADDRESS-GROUPS (must be removed BEFORE their member addresses,
;    and AFTER the rules above that reference them). This also clears stale
;    members like DSW1-IP/DSW2-IP that accumulated from prior additive runs.
; ---------------------------------------------------------------------
sendln 'delete address-group STAFF-ATM'
wait '[edit]'
sendln 'delete address-group HR-IT'
wait '[edit]'
sendln 'delete address-group INTERNET-USERS'
wait '[edit]'
sendln 'delete address-group DSWs'
wait '[edit]'

; ---------------------------------------------------------------------
; 5. DELETE ADDRESS OBJECTS (includes stale DSW1-IP/DSW2-IP from old runs)
; ---------------------------------------------------------------------
sendln 'delete address STAFF'
wait '[edit]'
sendln 'delete address ATM'
wait '[edit]'
sendln 'delete address HR-NET'
wait '[edit]'
sendln 'delete address IT-NET'
wait '[edit]'
sendln 'delete address SERVERS'
wait '[edit]'
sendln 'delete address DMZ-SUBNET'
wait '[edit]'
sendln 'delete address FILE-SVR'
wait '[edit]'
sendln 'delete address ACCT-SVR'
wait '[edit]'
sendln 'delete address TXN-SVR'
wait '[edit]'
sendln 'delete address DHCP-SVR'
wait '[edit]'
sendln 'delete address WEB-SVR'
wait '[edit]'
sendln 'delete address DNS-SVR'
wait '[edit]'
sendln 'delete address JUMP-SVR'
wait '[edit]'
sendln 'delete address JUMP2-SVR'
wait '[edit]'
sendln 'delete address PUB-PAT'
wait '[edit]'
sendln 'delete address PUB-WEB'
wait '[edit]'
sendln 'delete address PUB-DNS'
wait '[edit]'
sendln 'delete address DNS-FORWARDERS-1'
wait '[edit]'
sendln 'delete address DNS-FORWARDERS-2'
wait '[edit]'
sendln 'delete address ICT-DNS'
wait '[edit]'
sendln 'delete address DSW1-SVI'
wait '[edit]'
sendln 'delete address DSW2-SVI'
wait '[edit]'
; Stale objects from earlier macro versions (safe if they do not exist):
sendln 'delete address DSW1-IP'
wait '[edit]'
sendln 'delete address DSW2-IP'
wait '[edit]'

; ---------------------------------------------------------------------
; 6. DELETE SERVICE OBJECTS recreated by the main macro
; ---------------------------------------------------------------------
sendln 'delete service TCP-2222'
wait '[edit]'
sendln 'delete service UDP-67'
wait '[edit]'

; Schedule: the live box has 'recurring daily'; pa440.ttl recreates it as
; weekdays only (matches the ASA time-range). Safe here: TXN-INTERNET-TIMED,
; the only rule using it, was deleted in section 1.
sendln 'delete schedule TXN-WINDOW'
wait '[edit]'

; ---------------------------------------------------------------------
; 7. REMOVE THE OLD BYPASS / SERVER-BACKUP INTERFACES (5 Nov redesign)
;    Order: OSPF and VR membership -> zone membership -> zones -> VLAN
;    objects -> VLAN interfaces -> layer2 port config. A port can't change
;    from layer2 to layer3 until its layer2 config and zone are gone.
; ---------------------------------------------------------------------
sendln 'delete network virtual-router default protocol ospf area 0.0.0.0 interface vlan.100'
wait '[edit]'
sendln 'delete network virtual-router default protocol ospf area 0.0.0.0 interface vlan.69'
wait '[edit]'
sendln 'delete network virtual-router default interface vlan.100'
wait '[edit]'
sendln 'delete network virtual-router default interface vlan.69'
wait '[edit]'
sendln 'delete zone inside network layer3 vlan.100'
wait '[edit]'
sendln 'delete zone inside-l2'
wait '[edit]'
sendln 'delete zone server'
wait '[edit]'
sendln 'delete zone server-l2'
wait '[edit]'
sendln 'delete network vlan VL-INSIDE-BYPASS'
wait '[edit]'
sendln 'delete network vlan VL-SERVER'
wait '[edit]'
sendln 'delete network interface vlan units vlan.100'
wait '[edit]'
sendln 'delete network interface vlan units vlan.69'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/6 layer2'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/7 layer2'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/8 layer2'
wait '[edit]'
; Untracked static default via R1 (removed 5 Nov). OSPF supplies the default
; from R1 or R2; this static would blackhole traffic when R1 is down.
sendln 'delete network virtual-router default routing-table ip static-route DEFAULT-OUT'
wait '[edit]'

; ---------------------------------------------------------------------
; 8. VERIFY (optional visual check) & COMMIT
; ---------------------------------------------------------------------
sendln 'show rulebase security rules'
wait '[edit]'
sendln 'show rulebase nat rules'
wait '[edit]'
sendln 'show address'
wait '[edit]'
sendln 'show address-group'
wait '[edit]'

sendln 'commit'
wait 'Configuration committed successfully'
sendln 'exit'
