; =====================================================================
; PA-440 cleanup - run before pa440.ttl on a PA that already has config
; PAN-OS 'set' commands add to the config instead of replacing it, so old
; rules and object members would pile up. This deletes every rule, object,
; group and service that pa440.ttl creates, plus leftovers from older
; versions. Deleting something that doesn't exist is harmless, so it's safe
; to re-run. Management and AAA settings are not touched.
; Order matters: rules first (they use the objects), then groups, then
; addresses and services.
; =====================================================================

; Enter configuration mode
wait '>'
sendln 'configure'
wait '[edit]'

; ---------------------------------------------------------------------
; 1. Security rules created by pa440.ttl
; ---------------------------------------------------------------------
sendln 'delete rulebase security rules INBOUND-WEB'
wait '[edit]'
sendln 'delete rulebase security rules INBOUND-DNS'
wait '[edit]'
sendln 'delete rulebase security rules JUMP-SSH-IN'
wait '[edit]'
sendln 'delete rulebase security rules INTERNAL-TO-DNS'
wait '[edit]'
sendln 'delete rulebase security rules INTERNAL-TO-WEB'
wait '[edit]'
sendln 'delete rulebase security rules IT-TO-JUMP-SSH'
wait '[edit]'
sendln 'delete rulebase security rules PTSO-HR-TO-FILE'
wait '[edit]'
sendln 'delete rulebase security rules PTSO-STAFF-ATM-SVR'
wait '[edit]'
sendln 'delete rulebase security rules HR-IT-INTERNET'
wait '[edit]'
sendln 'delete rulebase security rules TXN-INTERNET-TIMED'
wait '[edit]'
sendln 'delete rulebase security rules DMZ-OUTBOUND-NTP'
wait '[edit]'
sendln 'delete rulebase security rules DENY-ALL'
wait '[edit]'

; ---------------------------------------------------------------------
; 2. More rules, plus rules from older versions
; ---------------------------------------------------------------------
sendln 'delete rulebase security rules ALLOW-OSPF'
wait '[edit]'
sendln 'delete rulebase security rules DMZ-WEB-IN'
wait '[edit]'
sendln 'delete rulebase security rules DMZ-DNS-IN'
wait '[edit]'
sendln 'delete rulebase security rules PTSO-DHCP-RELAY'
wait '[edit]'
sendln 'delete rulebase security rules DNS-SVR-FORWARD'
wait '[edit]'
; Temporary rules used for software installs, in case one was left in
sendln 'delete rulebase security rules TEMP-SVR-UPDATES'
wait '[edit]'
sendln 'delete rulebase security rules TEMP-JUMP-TO-SERVERS'
wait '[edit]'
sendln 'delete rulebase security rules TEMP-JUMP-UPDATES'
wait '[edit]'
; Wazuh agent rule (recreated before DENY-ALL by pa440.ttl)
sendln 'delete rulebase security rules WAZUH-AGENTS'
wait '[edit]'

; ---------------------------------------------------------------------
; 3. NAT rules from older versions (NAT is now done on R1/R2)
; ---------------------------------------------------------------------
sendln 'delete rulebase nat rules NAT-WEB'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-WEB-HTTPS'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-DNS'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-JUMP-SSH'
wait '[edit]'
sendln 'delete rulebase nat rules NAT-OUTBOUND'
wait '[edit]'
sendln 'delete rulebase nat rules TEMP-SVR-NAT'
wait '[edit]'

; ---------------------------------------------------------------------
; 4. Address groups (before their member addresses)
; ---------------------------------------------------------------------
sendln 'delete address-group STAFF-ATM'
wait '[edit]'
sendln 'delete address-group HR-IT'
wait '[edit]'
sendln 'delete address-group INTERNET-USERS'
wait '[edit]'
sendln 'delete address-group DSWs'
wait '[edit]'

; ---------------------------------------------------------------------
; 5. Address objects
; ---------------------------------------------------------------------
sendln 'delete address STAFF'
wait '[edit]'
sendln 'delete address ATM'
wait '[edit]'
sendln 'delete address HR-NET'
wait '[edit]'
sendln 'delete address IT-NET'
wait '[edit]'
sendln 'delete address SERVERS'
wait '[edit]'
sendln 'delete address DMZ-SUBNET'
wait '[edit]'
sendln 'delete address FILE-SVR'
wait '[edit]'
sendln 'delete address ACCT-SVR'
wait '[edit]'
sendln 'delete address TXN-SVR'
wait '[edit]'
sendln 'delete address DHCP-SVR'
wait '[edit]'
sendln 'delete address WEB-SVR'
wait '[edit]'
sendln 'delete address DNS-SVR'
wait '[edit]'
sendln 'delete address CACHE-DNS'
wait '[edit]'
sendln 'delete address JUMP-SVR'
wait '[edit]'
sendln 'delete address JUMP2-SVR'
wait '[edit]'
sendln 'delete address PUB-PAT'
wait '[edit]'
sendln 'delete address PUB-WEB'
wait '[edit]'
sendln 'delete address PUB-DNS'
wait '[edit]'
sendln 'delete address DNS-FORWARDERS-1'
wait '[edit]'
sendln 'delete address DNS-FORWARDERS-2'
wait '[edit]'
sendln 'delete address ICT-DNS'
wait '[edit]'
sendln 'delete address DSW1-SVI'
wait '[edit]'
sendln 'delete address DSW2-SVI'
wait '[edit]'
; Objects from older versions
sendln 'delete address DSW1-IP'
wait '[edit]'
sendln 'delete address DSW2-IP'
wait '[edit]'

; ---------------------------------------------------------------------
; 6. Service objects and the schedule
; ---------------------------------------------------------------------
sendln 'delete service TCP-2222'
wait '[edit]'
sendln 'delete service UDP-67'
wait '[edit]'
sendln 'delete service WAZUH-AGENT'
wait '[edit]'

; The only rule using it was deleted above; pa440.ttl recreates it.
sendln 'delete schedule TXN-WINDOW'
wait '[edit]'

; ---------------------------------------------------------------------
; 7. Old interface design (vlan.100 bypass, vlan.69 server backup), so
;    pa440.ttl can make eth1/6 and eth1/7 routed. Order: OSPF and router
;    membership, zones, VLANs, VLAN interfaces, then the layer 2 port config.
; ---------------------------------------------------------------------
sendln 'delete network virtual-router default protocol ospf area 0.0.0.0 interface vlan.100'
wait '[edit]'
sendln 'delete network virtual-router default protocol ospf area 0.0.0.0 interface vlan.69'
wait '[edit]'
sendln 'delete network virtual-router default interface vlan.100'
wait '[edit]'
sendln 'delete network virtual-router default interface vlan.69'
wait '[edit]'
sendln 'delete zone inside network layer3 vlan.100'
wait '[edit]'
sendln 'delete zone inside-l2'
wait '[edit]'
sendln 'delete zone server'
wait '[edit]'
sendln 'delete zone server-l2'
wait '[edit]'
sendln 'delete network vlan VL-INSIDE-BYPASS'
wait '[edit]'
sendln 'delete network vlan VL-SERVER'
wait '[edit]'
sendln 'delete network interface vlan units vlan.100'
wait '[edit]'
sendln 'delete network interface vlan units vlan.69'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/6 layer2'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/7 layer2'
wait '[edit]'
sendln 'delete network interface ethernet ethernet1/8 layer2'
wait '[edit]'
; Old static default route (the default now comes from OSPF)
sendln 'delete network virtual-router default routing-table ip static-route DEFAULT-OUT'
wait '[edit]'

; ---------------------------------------------------------------------
; 8. Show what's left, then commit
; ---------------------------------------------------------------------
sendln 'show rulebase security rules'
wait '[edit]'
sendln 'show rulebase nat rules'
wait '[edit]'
sendln 'show address'
wait '[edit]'
sendln 'show address-group'
wait '[edit]'

sendln 'commit'
wait 'Configuration committed successfully'
sendln 'exit'
