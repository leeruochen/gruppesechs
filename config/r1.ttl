; =====================================================================
; Tera Term Macro Script for R1 PTSO Configuration
; =====================================================================

; Enter enable mode
wait '>'
sendln 'enable'
wait 'Password:'
sendln 'Student@s1t'

; Enter configuration mode
wait '#'
sendln 'configure terminal'
wait '#'

; Base System Setup
sendln 'hostname R1'
wait '#'
sendln 'no ip domain lookup'
wait '#'
sendln 'ip domain name gruppesechs.sitict.net'
wait '#'
sendln 'service password-encryption'
wait '#'
sendln 'service timestamps log datetime msec localtime'
wait '#'
sendln 'clock timezone SGT 8 0'
wait '#'

; Banner MOTD
sendln 'banner motd ^C'
sendln 'WARNING: UNAUTHORIZED ACCESS TO GRUPPESECHS R1 IS PROHIBITED.'
sendln '^C'
wait '#'

; 1. Root Enable Secret & Manager Local Account
sendln 'enable algorithm-type scrypt secret 4Venison2'
wait '#'
sendln 'username bigDonkBonkAdmin privilege 15 algorithm-type scrypt secret Venison2Beef'
wait '#'

; 2. Out-of-Band (OOB) VRF Definition
sendln 'vrf definition OOB'
wait '#'
sendln 'address-family ipv4'
wait '#'
sendln 'exit-address-family'
wait '#'
sendln 'exit'
wait '#'

; 3. Perimeter WAN-IN ACL & VTY Management ACL
sendln 'ip access-list standard MGMT-ONLY'
wait '#'
sendln 'permit host 172.16.0.44'
wait '#'
sendln 'permit host 172.16.0.45'
wait '#'
sendln 'deny any log'
wait '#'
sendln 'exit'
wait '#'

; WAN-IN is checked BEFORE NAT on the outside interface, so the public-block
; permits below still match the public (pre-translation) addresses.
sendln 'ip access-list extended WAN-IN'
wait '#'
sendln 'deny tcp any host 172.17.9.94 eq 22 log'
wait '#'
sendln 'deny tcp any host 172.17.9.94 eq 23 log'
wait '#'
sendln 'permit icmp host 172.17.9.94 host 172.17.9.93 echo-reply'
wait '#'
sendln 'permit icmp any 203.149.210.184 0.0.0.7'
wait '#'
sendln 'permit ip any 203.149.210.184 0.0.0.7'
wait '#'
sendln 'permit tcp any host 172.17.9.93 established'
wait '#'
sendln 'deny ip any any log'
wait '#'
sendln 'exit'
wait '#'

; NAT-SOURCES: the only inside addresses R1 will PAT to the internet (5 Nov:
; NAT moved from the PA to the routers). The PA still decides what may leave;
; this ACL is a second layer, so Staff/ATM can't get out even if a firewall
; rule were wrong. Mirrors the PA's outbound rules.
sendln 'ip access-list extended NAT-SOURCES'
wait '#'
sendln 'permit ip 172.16.0.56 0.0.0.7 any'
wait '#'
sendln 'permit ip 172.16.0.64 0.0.0.7 any'
wait '#'
sendln 'permit ip host 172.16.0.76 any'
wait '#'
sendln 'permit ip host 172.16.0.83 any'
wait '#'
sendln 'permit ip host 172.16.0.84 any'
wait '#'
sendln 'permit ip host 172.16.0.85 any'
wait '#'
; TEMPORARY (HANDOVER.md 8.4): while servers still need package installs, add
;   permit ip 172.16.0.72 0.0.0.7 any
;   permit ip 172.16.0.80 0.0.0.7 any
; by hand and remove them with the PA's TEMP-SVR-UPDATES rule.
sendln 'exit'
wait '#'

; 4. Flexible NetFlow v9 Configuration
sendln 'flow record bank-flow-record'
wait '#'
sendln 'description packet flow record for monitoring'
wait '#'
sendln 'match ipv4 source address'
wait '#'
sendln 'match ipv4 destination address'
wait '#'
sendln 'match transport source-port'
wait '#'
sendln 'match transport destination-port'
wait '#'
sendln 'match ipv4 protocol'
wait '#'
sendln 'match ipv4 tos'
wait '#'
sendln 'match interface input'
wait '#'
sendln 'collect interface output'
wait '#'
sendln 'collect counter bytes long'
wait '#'
sendln 'collect counter packets long'
wait '#'
sendln 'collect timestamp absolute first'
wait '#'
sendln 'collect timestamp absolute last'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow exporter bank-flow-exporter-1'
wait '#'
sendln 'description export flows to tacacs1 .44'
wait '#'
sendln 'destination 172.16.0.44 vrf OOB'
wait '#'
sendln 'source GigabitEthernet0/1/0'
wait '#'
sendln 'transport udp 2055'
wait '#'
sendln 'export-protocol netflow-v9'
wait '#'
sendln 'template data timeout 60'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow exporter bank-flow-exporter-2'
wait '#'
sendln 'description export flows to tacacs2 .45'
wait '#'
sendln 'destination 172.16.0.45 vrf OOB'
wait '#'
sendln 'source GigabitEthernet0/1/0'
wait '#'
sendln 'transport udp 2055'
wait '#'
sendln 'export-protocol netflow-v9'
wait '#'
sendln 'template data timeout 60'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow monitor bank-flow-monitor'
wait '#'
sendln 'description Redundant Dual-Collector Traffic Visibility'
wait '#'
sendln 'exporter bank-flow-exporter-1'
wait '#'
sendln 'exporter bank-flow-exporter-2'
wait '#'
sendln 'record bank-flow-record'
wait '#'
sendln 'cache timeout active 60'
wait '#'
sendln 'cache timeout inactive 15'
wait '#'
sendln 'exit'
wait '#'

; 5. Physical Routed Interfaces
sendln 'interface GigabitEthernet0/0/0'
wait '#'
sendln 'description WAN_Link_to_ISP1'
wait '#'
sendln 'ip address 172.17.9.93 255.255.255.252'
wait '#'
sendln 'ip access-group WAN-IN in'
wait '#'
sendln 'ip nat outside'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface GigabitEthernet0/0/1'
wait '#'
sendln 'description Primary_Transit_to_PA440_eth1_5'
wait '#'
sendln 'ip address 172.16.0.90 255.255.255.248'
wait '#'
sendln 'ip nat inside'
wait '#'
sendln 'ip ospf cost 10'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface GigabitEthernet0/1/0'
wait '#'
sendln 'description OOB_Management_Gateway_VLAN99'
wait '#'
sendln 'vrf forwarding OOB'
wait '#'
sendln 'ip address 172.16.0.33 255.255.255.240'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface GigabitEthernet0/1/1'
wait '#'
sendln 'description PA_Bypass_Link_to_ASA_E1_5'
wait '#'
; 5 Nov: the R1-R2 link is gone (each router now has its own ISP). G0/1/1 is
; recabled to ASA E1/5 (172.16.0.108/30, R1 .109, ASA .110). Cost 500: only
; used when the PA is down. R1 then NATs the ASA's traffic itself.
; The lab image pre-assigns G0/1/1 to the factory 'Mgmt-vrf'. That keeps the
; interface out of global OSPF and the global routing table. Remove it BEFORE
; setting the IP: this command deletes any IP address on the interface.
; Harmless if the VRF is not assigned.
sendln 'no vrf forwarding Mgmt-vrf'
wait '#'
sendln 'ip address 172.16.0.109 255.255.255.252'
wait '#'
sendln 'ip nat inside'
wait '#'
sendln 'ip ospf cost 500'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; 6. IP SLA 1 (Track ISP1)
; IP SLA 2 / track 2 (ping the PA .92) were REMOVED 5 Nov: they only guarded
; the public-block static routes, which no longer exist (NAT is on R1).
sendln 'ip sla 1'
wait '#'
sendln 'icmp-echo 172.17.9.94 source-interface GigabitEthernet0/0/0'
wait '#'
sendln 'frequency 5'
wait '#'
sendln 'exit'
wait '#'

sendln 'ip sla schedule 1 life forever start-time now'
wait '#'
sendln 'track 1 ip sla 1 reachability'
wait '#'
sendln 'exit'
wait '#'

; 7. Static Routes (Tracked WAN Default Route)
; STATIC ROUTE: REQUIRED (OSPF does NOT provide it).
; The ISP does not run OSPF, so this is the only source of R1's default route.
; It is also what 'default-information originate' below advertises into OSPF
; for every other device. Must point at the ISP .94, NEVER .93 (R1 itself).
sendln 'ip route 0.0.0.0 0.0.0.0 172.17.9.94 track 1'
wait '#'
; STATIC ROUTE: OPTIONAL (best practice, not needed for forwarding).
; The ISP1 public block now ends at R1's NAT. NAT translates inbound packets
; before routing, so translated traffic never uses this route. It only catches
; packets for unused public addresses (e.g. .186), which would otherwise follow
; the default back to the ISP and loop until their TTL expires.
sendln 'ip route 203.149.210.184 255.255.255.248 Null0'
wait '#'

; 7b. NAT (moved from the PA to R1 on 5 Nov; R2 does the same for ISP2)
; Inside: G0/0/1 (PA) and G0/1/1 (ASA, PA-down path). Outside: G0/0/0 (ISP1).
; Outbound PAT for NAT-SOURCES to 203.149.210.185.
sendln 'ip nat pool PUB-PAT 203.149.210.185 203.149.210.185 prefix-length 29'
wait '#'
sendln 'ip nat inside source list NAT-SOURCES pool PUB-PAT overload'
wait '#'
; Inbound port forwards (port-specific, so only these ports reach the DMZ; the
; PA still filters them by App-ID). 'extendable' lets one public IP carry
; several port mappings, and lets .185 share the PAT pool above.
; If IOS rejects the .185:2222 line because .185 is the PAT pool, move the
; PAT pool to .186 (both lines of the pool) instead.
sendln 'ip nat inside source static tcp 172.16.0.82 80 203.149.210.189 80 extendable'
wait '#'
sendln 'ip nat inside source static tcp 172.16.0.82 443 203.149.210.189 443 extendable'
wait '#'
sendln 'ip nat inside source static udp 172.16.0.83 53 203.149.210.190 53 extendable'
wait '#'
sendln 'ip nat inside source static tcp 172.16.0.83 53 203.149.210.190 53 extendable'
wait '#'
sendln 'ip nat inside source static tcp 172.16.0.84 22 203.149.210.185 2222 extendable'
wait '#'

; 8. OSPF Routing (Area 0)
sendln 'router ospf 1'
wait '#'
sendln 'router-id 1.1.1.1'
wait '#'
sendln 'auto-cost reference-bandwidth 10000'
wait '#'
sendln 'passive-interface default'
wait '#'
sendln 'no passive-interface GigabitEthernet0/0/1'
wait '#'
sendln 'no passive-interface GigabitEthernet0/1/1'
wait '#'
sendln 'network 172.16.0.88 0.0.0.7 area 0'
wait '#'
sendln 'network 172.16.0.108 0.0.0.3 area 0'
wait '#'
; Primary ISP: metric 10 (R2 advertises ISP2 at 50). E1, so every device adds
; its own path cost and picks R1 while R1 has a default. The default is only
; advertised while track 1 (ISP1 reachable) is up.
sendln 'default-information originate metric 10 metric-type 1'
wait '#'
sendln 'log-adjacency-changes'
wait '#'
sendln 'exit'
wait '#'

; 9. AAA, SSH, NTP & Syslog
sendln 'aaa new-model'
wait '#'

sendln 'tacacs server TACACS1'
wait '#'
sendln 'address ipv4 172.16.0.44'
wait '#'
sendln 'key bigBoy@ServerPassword1'
wait '#'
sendln 'exit'
wait '#'

sendln 'tacacs server TACACS2'
wait '#'
sendln 'address ipv4 172.16.0.45'
wait '#'
sendln 'key bigBoy@ServerPassword2'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa group server tacacs+ tac-group'
wait '#'
sendln 'server name TACACS1'
wait '#'
sendln 'server name TACACS2'
wait '#'
sendln 'ip vrf forwarding OOB'
wait '#'
sendln 'ip tacacs source-interface GigabitEthernet0/1/0'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa authentication login default group tac-group local'
wait '#'
sendln 'aaa authentication login CONSOLE group tac-group local'
wait '#'
sendln 'aaa authorization exec default group tac-group local'
wait '#'
sendln 'aaa authorization config-commands'
wait '#'
sendln 'aaa authorization commands 15 default group tac-group local'
wait '#'
sendln 'aaa accounting exec default start-stop group tac-group'
wait '#'
sendln 'aaa accounting commands 15 default stop-only group tac-group'
wait '#'

sendln 'crypto key generate rsa modulus 2048'
wait '#'
sendln 'ip ssh version 2'
wait '#'
sendln 'ip ssh time-out 60'
wait '#'
sendln 'ip ssh authentication-retries 3'
wait '#'

sendln 'line con 0'
wait '#'
sendln 'login authentication CONSOLE'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 0 2'
wait '#'
sendln 'access-class MGMT-ONLY in vrf-also'
wait '#'
sendln 'transport input ssh'
wait '#'
sendln 'login authentication default'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 3 15'
wait '#'
sendln 'transport input none'
wait '#'
sendln 'exit'
wait '#'

sendln 'ntp server vrf OOB 172.16.0.44 prefer'
wait '#'
sendln 'ntp server vrf OOB 172.16.0.45'
wait '#'
sendln 'logging host 172.16.0.44 vrf OOB'
wait '#'
sendln 'logging host 172.16.0.45 vrf OOB'
wait '#'
sendln 'logging trap informational'
wait '#'

; End Phase 1 config
sendln 'end'
wait '#'

; =====================================================================
; PHASE 2: PARSER VIEW AND ROLE-BASED ACCESS
; =====================================================================

sendln 'enable view'
wait 'Password:'
sendln '4Venison2'
wait '#'

sendln 'configure terminal'
wait '#'

sendln 'parser view eng-view'
wait '#'
sendln 'secret engViewTriple3'
wait '#'
sendln 'commands exec include all show'
wait '#'
sendln 'commands exec include ping'
wait '#'
sendln 'commands exec include traceroute'
wait '#'
sendln 'commands exec include clear'
wait '#'
sendln 'commands configure include interface'
wait '#'
sendln 'commands interface include shutdown'
wait '#'
sendln 'commands interface include no shutdown'
wait '#'
sendln 'commands exec include configure terminal'
wait '#'
sendln 'commands exec include configure'
wait '#'
sendln 'exit'
wait '#'

sendln 'username donkBonkEng1 view eng-view algorithm-type scrypt secret Beef2Venison'
wait '#'
sendln 'username donkBonkEng2 view eng-view algorithm-type scrypt secret Beef3Venison'
wait '#'

; End config
sendln 'end'
wait '#'