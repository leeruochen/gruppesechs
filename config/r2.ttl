; =====================================================================
; Tera Term Macro Script for R2 PTSO Configuration
; =====================================================================

; Enter enable mode
wait '>'
sendln 'enable'
wait 'Password:'
sendln 'Student@s1t'

; Enter configuration mode
wait '#'
sendln 'configure terminal'
wait '#'

; Base System Setup
sendln 'hostname R2'
wait '#'
sendln 'no ip domain lookup'
wait '#'
sendln 'ip domain name gruppesechs.sitict.net'
wait '#'
sendln 'service password-encryption'
wait '#'
sendln 'service timestamps log datetime msec localtime'
wait '#'
sendln 'clock timezone SGT 8 0'
wait '#'

; Banner MOTD
sendln 'banner motd ^C'
sendln 'WARNING: UNAUTHORIZED ACCESS TO GRUPPESECHS R2 IS PROHIBITED.'
sendln '^C'
wait '#'

; 1. Root Enable Secret & Manager Local Account
sendln 'enable algorithm-type scrypt secret 4Venison2'
wait '#'
sendln 'username bigDonkBonkAdmin privilege 15 algorithm-type scrypt secret Venison2Beef'
wait '#'

; 2. Out-of-Band (OOB) VRF Definition
sendln 'vrf definition OOB'
wait '#'
sendln 'address-family ipv4'
wait '#'
sendln 'exit-address-family'
wait '#'
sendln 'exit'
wait '#'

; 3. VTY Management ACL
sendln 'ip access-list standard MGMT-ONLY'
wait '#'
sendln 'permit host 172.16.0.44'
wait '#'
sendln 'permit host 172.16.0.45'
wait '#'
sendln 'deny any log'
wait '#'
sendln 'exit'
wait '#'

; 4. Flexible NetFlow v9 Configuration
sendln 'flow record bank-flow-record'
wait '#'
sendln 'description packet flow record for monitoring'
wait '#'
sendln 'match ipv4 source address'
wait '#'
sendln 'match ipv4 destination address'
wait '#'
sendln 'match transport source-port'
wait '#'
sendln 'match transport destination-port'
wait '#'
sendln 'match ipv4 protocol'
wait '#'
sendln 'match ipv4 tos'
wait '#'
sendln 'match interface input'
wait '#'
sendln 'collect interface output'
wait '#'
sendln 'collect counter bytes long'
wait '#'
sendln 'collect counter packets long'
wait '#'
sendln 'collect timestamp absolute first'
wait '#'
sendln 'collect timestamp absolute last'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow exporter bank-flow-exporter-1'
wait '#'
sendln 'description export flows to tacacs1 .44'
wait '#'
sendln 'destination 172.16.0.44 vrf OOB'
wait '#'
sendln 'source GigabitEthernet0/1/0'
wait '#'
sendln 'transport udp 2055'
wait '#'
sendln 'export-protocol netflow-v9'
wait '#'
sendln 'template data timeout 60'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow exporter bank-flow-exporter-2'
wait '#'
sendln 'description export flows to tacacs2 .45'
wait '#'
sendln 'destination 172.16.0.45 vrf OOB'
wait '#'
sendln 'source GigabitEthernet0/1/0'
wait '#'
sendln 'transport udp 2055'
wait '#'
sendln 'export-protocol netflow-v9'
wait '#'
sendln 'template data timeout 60'
wait '#'
sendln 'exit'
wait '#'

sendln 'flow monitor bank-flow-monitor'
wait '#'
sendln 'description Redundant Dual-Collector Traffic Visibility'
wait '#'
sendln 'exporter bank-flow-exporter-1'
wait '#'
sendln 'exporter bank-flow-exporter-2'
wait '#'
sendln 'record bank-flow-record'
wait '#'
sendln 'cache timeout active 60'
wait '#'
sendln 'cache timeout inactive 15'
wait '#'
sendln 'exit'
wait '#'

; 5. Physical Routed Interfaces
; PTSO Bypass Link to Firepower 1010 ASA (Ethernet1/2 - Cost 500)
sendln 'interface GigabitEthernet0/0/0'
wait '#'
sendln 'description PTSO_Bypass_Link_to_ASA_E1_2'
wait '#'
sendln 'ip address 172.16.0.113 255.255.255.252'
wait '#'
sendln 'ip ospf cost 500'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; Secondary Redundant Transit Link to PA-440 (eth1/2 - VLAN 10)
sendln 'interface GigabitEthernet0/0/1'
wait '#'
sendln 'description Secondary_Transit_to_PA440_eth1_2'
wait '#'
sendln 'ip address 172.16.0.91 255.255.255.248'
wait '#'
sendln 'ip ospf cost 20'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; Dedicated Out-of-Band (OOB) Management Interface
sendln 'interface GigabitEthernet0/1/0'
wait '#'
sendln 'description OOB_Management_Interface_VLAN99'
wait '#'
sendln 'vrf forwarding OOB'
wait '#'
sendln 'ip address 172.16.0.34 255.255.255.240'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; Direct Inter-Router Link to R1 (G0/1/1)
sendln 'interface GigabitEthernet0/1/1'
wait '#'
sendln 'description Direct_InterRouter_Link_to_R1'
wait '#'
; The lab image pre-assigns G0/1/1 to the factory 'Mgmt-vrf' (and a DHCP
; client-id). That keeps the interface out of global OSPF and the global
; routing table, so R1-R2 never peer on this link. Remove it BEFORE setting
; the IP: this command deletes any IP address on the interface.
sendln 'no vrf forwarding Mgmt-vrf'
wait '#'
sendln 'no ip dhcp client client-id'
wait '#'
sendln 'ip address 172.16.0.110 255.255.255.252'
wait '#'
sendln 'ip ospf cost 5'
wait '#'
sendln 'ip flow monitor bank-flow-monitor input'
wait '#'
sendln 'no ip redirects'
wait '#'
sendln 'no ip proxy-arp'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; 6. IP SLA 2 (Track PA-440 .92) & Floating Static Route for Public NAT Block
sendln 'ip sla 2'
wait '#'
sendln 'icmp-echo 172.16.0.92'
wait '#'
sendln 'frequency 5'
wait '#'
sendln 'exit'
wait '#'

sendln 'ip sla schedule 2 life forever start-time now'
wait '#'
sendln 'track 2 ip sla 2 reachability'
wait '#'
sendln 'exit'
wait '#'

; STATIC ROUTE: REQUIRED for the backup path (OSPF does NOT provide it).
; The public NAT block 203.149.210.184/29 is never advertised into OSPF (the
; PA owns it only as NAT addresses), so R2 must be told where it lives. R2 only
; uses this when R1 hands public-block traffic to R2 (R1's AD 250 backup).
sendln 'ip route 203.149.210.184 255.255.255.248 172.16.0.92 track 2'
wait '#'
; STATIC ROUTE: OPTIONAL (redundancy only, not related to OSPF).
; Floating route (AD 250) to the ASA wan-backup interface, used only if the PA
; (.92) fails. Safe to omit if you are not testing PA failover.
sendln 'ip route 203.149.210.184 255.255.255.248 172.16.0.114 250'
wait '#'

; 7. OSPF Routing (Area 0)
sendln 'router ospf 1'
wait '#'
sendln 'router-id 2.2.2.2'
wait '#'
sendln 'auto-cost reference-bandwidth 10000'
wait '#'
sendln 'passive-interface default'
wait '#'
sendln 'no passive-interface GigabitEthernet0/0/0'
wait '#'
sendln 'no passive-interface GigabitEthernet0/0/1'
wait '#'
sendln 'no passive-interface GigabitEthernet0/1/1'
wait '#'
sendln 'network 172.16.0.88 0.0.0.7 area 0'
wait '#'
sendln 'network 172.16.0.108 0.0.0.3 area 0'
wait '#'
sendln 'network 172.16.0.112 0.0.0.3 area 0'
wait '#'
sendln 'log-adjacency-changes'
wait '#'
sendln 'exit'
wait '#'

; 8. AAA, SSH, NTP & Syslog
sendln 'aaa new-model'
wait '#'

sendln 'tacacs server TACACS1'
wait '#'
sendln 'address ipv4 172.16.0.44'
wait '#'
sendln 'key bigBoy@ServerPassword1'
wait '#'
sendln 'exit'
wait '#'

sendln 'tacacs server TACACS2'
wait '#'
sendln 'address ipv4 172.16.0.45'
wait '#'
sendln 'key bigBoy@ServerPassword2'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa group server tacacs+ tac-group'
wait '#'
sendln 'server name TACACS1'
wait '#'
sendln 'server name TACACS2'
wait '#'
sendln 'ip vrf forwarding OOB'
wait '#'
sendln 'ip tacacs source-interface GigabitEthernet0/1/0'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa authentication login default group tac-group local'
wait '#'
sendln 'aaa authentication login CONSOLE group tac-group local'
wait '#'
sendln 'aaa authorization exec default group tac-group local'
wait '#'
sendln 'aaa authorization config-commands'
wait '#'
sendln 'aaa authorization commands 15 default group tac-group local'
wait '#'
sendln 'aaa accounting exec default start-stop group tac-group'
wait '#'
sendln 'aaa accounting commands 15 default stop-only group tac-group'
wait '#'

sendln 'crypto key generate rsa modulus 2048'
wait '#'
sendln 'ip ssh version 2'
wait '#'
sendln 'ip ssh time-out 60'
wait '#'
sendln 'ip ssh authentication-retries 3'
wait '#'

sendln 'line con 0'
wait '#'
sendln 'login authentication CONSOLE'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 0 2'
wait '#'
sendln 'access-class MGMT-ONLY in vrf-also'
wait '#'
sendln 'transport input ssh'
wait '#'
sendln 'login authentication default'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 3 15'
wait '#'
sendln 'transport input none'
wait '#'
sendln 'exit'
wait '#'

sendln 'ntp server vrf OOB 172.16.0.44 prefer'
wait '#'
sendln 'ntp server vrf OOB 172.16.0.45'
wait '#'
sendln 'logging host 172.16.0.44 vrf OOB'
wait '#'
sendln 'logging host 172.16.0.45 vrf OOB'
wait '#'
sendln 'logging trap informational'
wait '#'

; End Phase 1 config
sendln 'end'
wait '#'

; =====================================================================
; PHASE 2: PARSER VIEW AND ROLE-BASED ACCESS
; =====================================================================

sendln 'enable view'
wait 'Password:'
sendln '4Venison2'
wait '#'

sendln 'configure terminal'
wait '#'

sendln 'parser view eng-view'
wait '#'
sendln 'secret engViewTriple3'
wait '#'
sendln 'commands exec include all show'
wait '#'
sendln 'commands exec include ping'
wait '#'
sendln 'commands exec include traceroute'
wait '#'
sendln 'commands exec include clear'
wait '#'
sendln 'commands configure include interface'
wait '#'
sendln 'commands interface include shutdown'
wait '#'
sendln 'commands interface include no shutdown'
wait '#'
sendln 'commands exec include configure terminal'
wait '#'
sendln 'commands exec include configure'
wait '#'
sendln 'exit'
wait '#'

sendln 'username donkBonkEng1 view eng-view algorithm-type scrypt secret Beef2Venison'
wait '#'
sendln 'username donkBonkEng2 view eng-view algorithm-type scrypt secret Beef3Venison'
wait '#'

; End config
sendln 'end'
wait '#'