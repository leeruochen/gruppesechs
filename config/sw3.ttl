; =====================================================================
; Tera Term Macro Script for SW3 Configuration
; =====================================================================

; Enter enable mode
wait '>'
sendln 'enable'
wait 'Password:'
sendln 'Student@s1t'

; Enter configuration mode
wait '#'
sendln 'configure terminal'
wait '#'

; Base System Setup
sendln 'hostname SW3'
wait '#'
sendln 'no ip domain lookup'
wait '#'
sendln 'ip domain name gruppesechs.sitict.net'
wait '#'
sendln 'service password-encryption'
wait '#'
sendln 'service timestamps log datetime msec localtime'
wait '#'
sendln 'clock timezone SGT 8 0'
wait '#'

; Banner MOTD
sendln 'banner motd ^C'
sendln 'WARNING: UNAUTHORIZED ACCESS TO GRUPPESECHS SW3 IS PROHIBITED.'
sendln '^C'
wait '#'

; 1. Root Enable Secret & Manager Local Account
sendln 'enable algorithm-type scrypt secret 4Venison2'
wait '#'
sendln 'username bigDonkBonkAdmin privilege 15 algorithm-type scrypt secret Venison2Beef'
wait '#'

; 2. Shut Down Unused Rear Gi0/0 Port
sendln 'interface GigabitEthernet0/0'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 3. VLAN Definitions & Spanning Tree
sendln 'vlan 61'
wait '#'
sendln 'name HR'
wait '#'
sendln 'vlan 99'
wait '#'
sendln 'name MGMT_OOB'
wait '#'
sendln 'vlan 727'
wait '#'
sendln 'name UNUSED_BLACKHOLE'
wait '#'
sendln 'vlan 821'
wait '#'
sendln 'name NATIVE_TRUNK'
wait '#'
sendln 'exit'
wait '#'

sendln 'spanning-tree mode rapid-pvst'
wait '#'

; 4. Global DHCP Snooping & Dynamic ARP Inspection (DAI)
sendln 'ip dhcp snooping'
wait '#'
sendln 'ip dhcp snooping vlan 61'
wait '#'
sendln 'no ip dhcp snooping information option'
wait '#'
sendln 'ip arp inspection vlan 61'
wait '#'

; 4b. OPTIONAL: Static HR Host Bindings (ONLY for a host with a STATIC IP)
; DISABLED since 4 Nov: HR hosts now get addresses from DHCP (VM107), and DHCP
; snooping creates the DAI / IP Source Guard bindings automatically.
; Do NOT enable these for a host that uses DHCP: a static binding for the same
; MAC blocks its lease binding, so DAI and IP Source Guard drop its traffic
; (seen 4 Nov as P12: laptop got .61 but had no connectivity).
; Uncomment only for a host configured with a static IP. Update the MAC / IP /
; interface to match it.
; sendln 'arp access-list STATIC-HR'
; wait '#'
; sendln 'permit ip host 172.16.0.60 mac host 74d4.dd81.5ca2'
; wait '#'
; sendln 'exit'
; wait '#'
; sendln 'ip arp inspection filter STATIC-HR vlan 61'
; wait '#'
; sendln 'ip source binding 74d4.dd81.5ca2 vlan 61 172.16.0.60 interface GigabitEthernet1/0/5'
; wait '#'

; 5. LACP Uplinks (Po1 to DSW1, Po2 to DSW2)
; Towards DSW1
sendln 'interface range GigabitEthernet1/0/1 - 2'
wait '#'
sendln 'description Uplink_to_DSW1'
wait '#'
sendln 'channel-group 1 mode active'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Port-channel1'
wait '#'
sendln 'description Trunk_to_DSW1'
wait '#'
sendln 'switchport mode trunk'
wait '#'
sendln 'switchport trunk native vlan 821'
wait '#'
sendln 'switchport trunk allowed vlan 61,99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'ip dhcp snooping trust'
wait '#'
sendln 'ip arp inspection trust'
wait '#'
sendln 'exit'
wait '#'

; Towards DSW2
sendln 'interface range GigabitEthernet1/0/3 - 4'
wait '#'
sendln 'description Uplink_to_DSW2'
wait '#'
sendln 'channel-group 2 mode active'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Port-channel2'
wait '#'
sendln 'description Trunk_to_DSW2'
wait '#'
sendln 'switchport mode trunk'
wait '#'
sendln 'switchport trunk native vlan 821'
wait '#'
sendln 'switchport trunk allowed vlan 61,99'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'ip dhcp snooping trust'
wait '#'
sendln 'ip arp inspection trust'
wait '#'
sendln 'exit'
wait '#'

; 6. HR End-User Access Ports (G1/0/5 - 6, Max 2 MAC)
sendln 'interface range GigabitEthernet1/0/5 - 6'
wait '#'
sendln 'description HR_Workstations_VLAN61'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 61'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'switchport port-security'
wait '#'
sendln 'switchport port-security maximum 2'
wait '#'
sendln 'switchport port-security mac-address sticky'
wait '#'
sendln 'switchport port-security violation shutdown'
wait '#'
sendln 'spanning-tree portfast'
wait '#'
sendln 'spanning-tree bpduguard enable'
wait '#'
sendln 'ip verify source'
wait '#'
sendln 'ip arp inspection limit rate 15'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; 7. Unused Ports Blackholed (G1/0/7 - 24)
sendln 'interface range GigabitEthernet1/0/7 - 24'
wait '#'
sendln 'description UNUSED_PORTS'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 727'
wait '#'
sendln 'switchport nonegotiate'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 8. OOB Management Interface (VLAN 99)
sendln 'interface Vlan99'
wait '#'
sendln 'description OOB_Management_SVI'
wait '#'
sendln 'ip address 172.16.0.39 255.255.255.240'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; DEFAULT GATEWAY: REQUIRED (not related to OSPF).
; Layer 2 access switches run no routing protocol. This lets the management
; SVI (VLAN 99) reach anything outside 172.16.0.32/28 via R1.
sendln 'ip default-gateway 172.16.0.33'
wait '#'

; 9. VTY ACL, AAA (Dual TACACS+), SSH, NTP & Syslog
sendln 'ip access-list standard MGMT-ONLY'
wait '#'
sendln 'permit host 172.16.0.44'
wait '#'
sendln 'permit host 172.16.0.45'
wait '#'
sendln 'deny any log'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa new-model'
wait '#'

sendln 'tacacs server TACACS1'
wait '#'
sendln 'address ipv4 172.16.0.44'
wait '#'
sendln 'key bigBoy@ServerPassword1'
wait '#'
sendln 'exit'
wait '#'

sendln 'tacacs server TACACS2'
wait '#'
sendln 'address ipv4 172.16.0.45'
wait '#'
sendln 'key bigBoy@ServerPassword2'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa group server tacacs+ tac-group'
wait '#'
sendln 'server name TACACS1'
wait '#'
sendln 'server name TACACS2'
wait '#'
sendln 'ip tacacs source-interface Vlan99'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa authentication login default group tac-group local'
wait '#'
sendln 'aaa authentication login CONSOLE group tac-group local'
wait '#'
sendln 'aaa authorization exec default group tac-group local'
wait '#'
sendln 'aaa authorization config-commands'
wait '#'
sendln 'aaa authorization commands 15 default group tac-group local'
wait '#'
sendln 'aaa accounting exec default start-stop group tac-group'
wait '#'
sendln 'aaa accounting commands 15 default stop-only group tac-group'
wait '#'

sendln 'crypto key generate rsa modulus 2048'
wait '#'
sendln 'ip ssh version 2'
wait '#'
sendln 'ip ssh time-out 60'
wait '#'
sendln 'ip ssh authentication-retries 3'
wait '#'

sendln 'line con 0'
wait '#'
sendln 'login authentication CONSOLE'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 0 2'
wait '#'
sendln 'access-class MGMT-ONLY in'
wait '#'
sendln 'transport input ssh'
wait '#'
sendln 'login authentication default'
wait '#'
sendln 'exec-timeout 10 0'
wait '#'
sendln 'exit'
wait '#'

sendln 'line vty 3 15'
wait '#'
sendln 'transport input none'
wait '#'
sendln 'exit'
wait '#'

sendln 'ntp server 172.16.0.44 prefer'
wait '#'
sendln 'ntp server 172.16.0.45'
wait '#'
sendln 'logging host 172.16.0.44'
wait '#'
sendln 'logging host 172.16.0.45'
wait '#'
sendln 'logging trap informational'
wait '#'

; End Phase 1 config
sendln 'end'
wait '#'

; =====================================================================
; PHASE 2: PARSER VIEW AND ROLE-BASED ACCESS
; =====================================================================

sendln 'enable view'
wait 'Password:'
sendln '4Venison2'
wait '#'

sendln 'configure terminal'
wait '#'

sendln 'parser view eng-view'
wait '#'
sendln 'secret engViewTriple3'
wait '#'
sendln 'commands exec include all show'
wait '#'
sendln 'commands exec include ping'
wait '#'
sendln 'commands exec include traceroute'
wait '#'
sendln 'commands exec include clear'
wait '#'
sendln 'commands configure include interface'
wait '#'
sendln 'commands interface include shutdown'
wait '#'
sendln 'commands interface include no shutdown'
wait '#'
sendln 'commands interface include switchport'
wait '#'
sendln 'commands exec include configure terminal'
wait '#'
sendln 'commands exec include configure'
wait '#'
sendln 'exit'
wait '#'

sendln 'username donkBonkEng1 view eng-view algorithm-type scrypt secret Beef2Venison'
wait '#'
sendln 'username donkBonkEng2 view eng-view algorithm-type scrypt secret Beef3Venison'
wait '#'

; End config
sendln 'end'
wait '#'