; =====================================================================
; Tera Term Macro Script for Firepower 1010 (ASA) PTSO Configuration
; Option 3: Dedicated Routed Link (Ethernet1/3) to DSW1
; =====================================================================

; Enter enable mode
wait '>'
sendln 'enable'
wait 'Password:'
sendln 'Student@s1t'

; Enter configuration mode
wait '#'
sendln 'configure terminal'
wait '#'

; Base System Setup
sendln 'hostname ASA-1010'
wait '#'
sendln 'domain-name gruppesechs.sitict.net'
wait '#'
sendln 'clock timezone Singapore'
wait '#'
sendln 'banner motd WARNING: UNAUTHORIZED ACCESS TO GRUPPESECHS ASA IS PROHIBITED.'
wait '#'

; 1. Clear Pre-existing AAA & RSA Keypairs
sendln 'clear configure aaa'
wait '#'
sendln 'crypto key zeroize rsa'
wait 'want to remove these keys?'
sendln 'yes'
wait '#'
sendln 'crypto key generate rsa modulus 2048 noconfirm'
wait '#'

; 2. Passwords & Local RBAC Accounts (Cleartext input hashed by ASA)
sendln 'enable password 4Venison2'
wait '#'
sendln 'username bigDonkBonkAdmin password Venison2Beef privilege 15'
wait '#'
sendln 'username donkBonkEng1 password Beef2Venison privilege 5'
wait '#'
sendln 'username donkBonkEng2 password Beef3Venison privilege 5'
wait '#'

sendln 'privilege show level 5 mode exec command running-config'
wait '#'
sendln 'privilege show level 5 mode exec command route'
wait '#'
sendln 'privilege show level 5 mode exec command ospf'
wait '#'
sendln 'privilege show level 5 mode exec command interface'
wait '#'
sendln 'privilege show level 5 mode exec command access-list'
wait '#'
sendln 'privilege cmd level 5 mode exec command ping'
wait '#'
sendln 'privilege cmd level 5 mode exec command traceroute'
wait '#'

; 3. Clean up Factory Defaults
; NOTE: 'no interface Port-channel1' / 'no interface Vlan100' removed - they
; error on a clean box where those objects do not exist. If a prior run left
; them behind, remove them manually before running this macro.
sendln 'clear configure dhcpd'
wait '#'

; CRITICAL (PTSO): remove the factory default dynamic NAT. Without this, the ASA
; PATs all inside->outside traffic to its own outside interface (172.16.0.106),
; which breaks the serial design - HR must traverse the ASA UN-NAT'd so the
; PA-440 performs the single outbound PAT to 203.149.210.185. Return traffic for
; .106 has no internet path, so leaving this in place silently blackholes HR.
sendln 'object network obj_any'
wait '#'
sendln 'no nat (any,outside) dynamic interface'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan1'
wait '#'
sendln 'no nameif'
wait '#'
sendln 'no security-level'
wait '#'
sendln 'no ip address'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 4. Routed Transit Interfaces
; Primary Serial Link to PA-440 (eth1/3 - Cost 10)
sendln 'interface Ethernet1/1'
wait '#'
sendln 'description Primary_Serial_Link_to_PA440_eth1_3'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif outside'
wait '#'
sendln 'security-level 0'
wait '#'
sendln 'ip address 172.16.0.106 255.255.255.252'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 10'
wait '#'
sendln 'exit'
wait '#'

; PTSO Router Bypass Link to R2 (G0/0/0 - Cost 500)
sendln 'interface Ethernet1/2'
wait '#'
sendln 'description PTSO_Bypass_Link_to_R2_G0_0_0'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif wan-backup'
wait '#'
sendln 'security-level 0'
wait '#'
sendln 'ip address 172.16.0.114 255.255.255.252'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 500'
wait '#'
sendln 'exit'
wait '#'

; Option 3: Dedicated Routed Inside Transit Port to DSW1 (G1/0/11)
sendln 'interface Ethernet1/3'
wait '#'
sendln 'description Inside_Transit_to_DSW1_G1_0_11'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'nameif inside'
wait '#'
sendln 'security-level 100'
wait '#'
sendln 'ip address 172.16.0.97 255.255.255.248'
wait '#'
sendln 'speed 1000'
wait '#'
sendln 'duplex full'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'ospf cost 10'
wait '#'
sendln 'exit'
wait '#'

; Spare Link to DSW2 (Kept shutdown to avoid multi-chassis conflicts)
sendln 'interface Ethernet1/4'
wait '#'
sendln 'description Spare_Link_to_DSW2_G1_0_11_SPARE'
wait '#'
sendln 'no switchport'
wait '#'
sendln 'no nameif'
wait '#'
sendln 'no ip address'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; Unused Port Ethernet1/5 Shut Down
sendln 'interface Ethernet1/5'
wait '#'
sendln 'description UNUSED_PORT'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 5. Server & DMZ Switchports and SVIs
sendln 'interface Ethernet1/6'
wait '#'
sendln 'description Link_to_DSW1_G1_0_14_VLAN69_Bridge'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 69'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan69'
wait '#'
sendln 'description Primary_Internal_Servers_Gateway_SVI'
wait '#'
sendln 'nameif server'
wait '#'
sendln 'security-level 60'
wait '#'
sendln 'ip address 172.16.0.73 255.255.255.248'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Ethernet1/7'
wait '#'
sendln 'description Link_to_DSW2_G1_0_15_VLAN92_Bridge'
wait '#'
sendln 'switchport mode access'
wait '#'
sendln 'switchport access vlan 92'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Vlan92'
wait '#'
sendln 'description Backup_DMZ_Servers_Gateway_SVI'
wait '#'
sendln 'nameif dmz'
wait '#'
sendln 'security-level 50'
wait '#'
sendln 'ip address 172.16.0.86 255.255.255.248'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

sendln 'interface Ethernet1/8'
wait '#'
sendln 'description UNUSED_PORT'
wait '#'
sendln 'shutdown'
wait '#'
sendln 'exit'
wait '#'

; 6. Dedicated OOB Management Interface (Connected to DSW2 G1/0/23)
sendln 'interface Management1/1'
wait '#'
sendln 'description OOB_Management_VLAN99'
wait '#'
sendln 'management-only'
wait '#'
sendln 'nameif management'
wait '#'
sendln 'security-level 100'
wait '#'
sendln 'ip address 172.16.0.42 255.255.255.240'
wait '#'
sendln 'no shutdown'
wait '#'
sendln 'exit'
wait '#'

; Static Route for Management OOB
sendln 'route management 0.0.0.0 0.0.0.0 172.16.0.33 1'
wait '#'

; 7. OSPF Routing (Area 0)
; ROOT-CAUSE FIX for 'ip_multicast_ctl failed to get channel 6/7':
;   On the Firepower 1010 ASA, OSPF cannot join its multicast groups
;   (224.0.0.5/6) on VLAN SVIs that are backed by switchports. Vlan69 (server,
;   on E1/6) and Vlan92 (dmz, on E1/7) are exactly such SVIs, so enabling OSPF
;   on them threw this error (confirmed: it fired even on 'clear configure
;   router ospf', i.e. on teardown - ruling out a paste-speed/scale cause).
;   OSPF adjacencies are only NEEDED on the three ROUTED PHYSICAL transit links:
;     inside (E1/3 -> DSW/PA), outside (E1/1 -> PA), wan-backup (E1/2 -> R2).
;   So we DO NOT run OSPF on the server/dmz SVIs; instead 'redistribute
;   connected subnets' advertises 172.16.0.72/29 and 172.16.0.80/29 into the
;   domain as external routes. Verified: neighbors to R2/PA/DSW1 reach FULL,
;   DSW2 stays 2WAY/DROTHER (normal on a broadcast segment), no multicast errors.
sendln 'router ospf 1'
wait '#'
sendln 'router-id 5.5.5.5'
wait '#'
sendln 'network 172.16.0.96 255.255.255.248 area 0'
wait '#'
sendln 'network 172.16.0.104 255.255.255.252 area 0'
wait '#'
sendln 'network 172.16.0.112 255.255.255.252 area 0'
wait '#'
sendln 'redistribute connected subnets'
wait '#'
sendln 'log-adj-changes'
wait '#'
sendln 'exit'
wait '#'

; 8. Network Objects & Object-Groups
sendln 'object network STAFF'
wait '#'
sendln 'subnet 172.16.0.0 255.255.255.224'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network ATM'
wait '#'
sendln 'subnet 172.16.0.48 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network HR'
wait '#'
sendln 'subnet 172.16.0.56 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network IT'
wait '#'
sendln 'subnet 172.16.0.64 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network SERVERS'
wait '#'
sendln 'subnet 172.16.0.72 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network DMZ-SUBNET'
wait '#'
sendln 'subnet 172.16.0.80 255.255.255.248'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network INTERNAL'
wait '#'
sendln 'subnet 172.16.0.0 255.255.255.128'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network FILE-SVR'
wait '#'
sendln 'host 172.16.0.74'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network ACCT-SVR'
wait '#'
sendln 'host 172.16.0.75'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network TXN-SVR'
wait '#'
sendln 'host 172.16.0.76'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network DHCP-SVR'
wait '#'
sendln 'host 172.16.0.77'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network WEB-SVR'
wait '#'
sendln 'host 172.16.0.82'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network DNS-SVR'
wait '#'
sendln 'host 172.16.0.83'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network JUMP-SVR'
wait '#'
sendln 'host 172.16.0.84'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network JUMP2-SVR'
wait '#'
sendln 'host 172.16.0.85'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network PUB-PAT'
wait '#'
sendln 'host 203.149.210.185'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network STAFF-ATM'
wait '#'
sendln 'network-object object STAFF'
wait '#'
sendln 'network-object object ATM'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network HR-IT'
wait '#'
sendln 'network-object object HR'
wait '#'
sendln 'network-object object IT'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network DSWs'
wait '#'
sendln 'network-object host 172.16.0.98'
wait '#'
sendln 'network-object host 172.16.0.99'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network JUMP-SVRs'
wait '#'
sendln 'network-object object JUMP-SVR'
wait '#'
sendln 'network-object object JUMP2-SVR'
wait '#'
sendln 'exit'
wait '#'

sendln 'object-group network PAT-USERS'
wait '#'
sendln 'network-object object HR'
wait '#'
sendln 'network-object object IT'
wait '#'
sendln 'network-object object TXN-SVR'
wait '#'
sendln 'network-object object JUMP-SVR'
wait '#'
sendln 'network-object object JUMP2-SVR'
wait '#'
sendln 'exit'
wait '#'

; 9. PTSO Standby NAT/PAT Rules
sendln 'object network WEB-SVR-NAT'
wait '#'
sendln 'host 172.16.0.82'
wait '#'
sendln 'nat (dmz,wan-backup) static 203.149.210.189'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network DNS-SVR-NAT'
wait '#'
sendln 'host 172.16.0.83'
wait '#'
sendln 'nat (dmz,wan-backup) static 203.149.210.190'
wait '#'
sendln 'exit'
wait '#'

sendln 'object network JUMP-SSH-NAT'
wait '#'
sendln 'host 172.16.0.84'
wait '#'
sendln 'nat (dmz,wan-backup) static 203.149.210.185 service tcp ssh 2222'
wait '#'
sendln 'exit'
wait '#'

; NOTE: The "Pool (203.149.210.185) overlap" warning below is EXPECTED and benign.
; JUMP-SSH-NAT statically maps .185 tcp/2222 -> jump host, while the dynamic PAT
; overloads the same .185 for outbound sessions. Static port-forward + PAT overload
; on one address is a valid ASA pattern; the ASA just warns about the shared address.
sendln 'nat (inside,wan-backup) after-auto source dynamic PAT-USERS PUB-PAT'
wait '#'
sendln 'nat (server,wan-backup) after-auto source dynamic PAT-USERS PUB-PAT'
wait '#'
sendln 'nat (dmz,wan-backup) after-auto source dynamic PAT-USERS PUB-PAT'
wait '#'

; 10. Time-Range for Transactions Server
sendln 'time-range TXN-WINDOW'
wait '#'
sendln 'periodic weekdays 01:00 to 03:00'
wait '#'
sendln 'exit'
wait '#'

; 11. Access Control Lists (ACLs)
sendln 'access-list INSIDE_IN extended permit ospf any any'
wait '#'
sendln 'access-list INSIDE_IN extended permit udp object-group DSWs object DHCP-SVR eq bootps'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object HR object FILE-SVR eq 445'
wait '#'
sendln 'access-list INSIDE_IN extended permit icmp object HR object FILE-SVR'
wait '#'
sendln 'access-list INSIDE_IN extended permit ip object-group STAFF-ATM object ACCT-SVR'
wait '#'
sendln 'access-list INSIDE_IN extended permit ip object-group STAFF-ATM object TXN-SVR'
wait '#'
sendln 'access-list INSIDE_IN extended permit udp object-group HR-IT object DNS-SVR eq domain'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object-group HR-IT object DNS-SVR eq domain'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object-group HR-IT object WEB-SVR eq www'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object-group HR-IT object WEB-SVR eq https'
wait '#'
sendln 'access-list INSIDE_IN extended permit tcp object IT object-group JUMP-SVRs eq ssh'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip any object SERVERS log'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip any object DMZ-SUBNET log'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip object-group STAFF-ATM any log'
wait '#'
sendln 'access-list INSIDE_IN extended permit ip object-group HR-IT any'
wait '#'
sendln 'access-list INSIDE_IN extended deny ip any any log'
wait '#'

sendln 'access-list SERVER_IN extended deny ip object SERVERS object INTERNAL log'
wait '#'
sendln 'access-list SERVER_IN extended permit tcp object TXN-SVR any eq www time-range TXN-WINDOW'
wait '#'
sendln 'access-list SERVER_IN extended permit tcp object TXN-SVR any eq https time-range TXN-WINDOW'
wait '#'
sendln 'access-list SERVER_IN extended permit udp object TXN-SVR object DNS-SVR eq domain time-range TXN-WINDOW'
wait '#'
sendln 'access-list SERVER_IN extended deny ip any any log'
wait '#'

sendln 'access-list DMZ_IN extended deny ip object DMZ-SUBNET object INTERNAL log'
wait '#'
sendln 'access-list DMZ_IN extended deny ip object DMZ-SUBNET object SERVERS log'
wait '#'
sendln 'access-list DMZ_IN extended permit udp object-group JUMP-SVRs any eq ntp'
wait '#'
sendln 'access-list DMZ_IN extended permit udp object-group JUMP-SVRs any eq domain'
wait '#'
sendln 'access-list DMZ_IN extended deny ip any any log'
wait '#'

sendln 'access-list OUTSIDE_IN extended permit ospf any any'
wait '#'
sendln 'access-list OUTSIDE_IN extended permit tcp any object WEB-SVR eq www'
wait '#'
sendln 'access-list OUTSIDE_IN extended permit tcp any object WEB-SVR eq https'
wait '#'
sendln 'access-list OUTSIDE_IN extended permit udp any object DNS-SVR eq domain'
wait '#'
sendln 'access-list OUTSIDE_IN extended permit tcp any object DNS-SVR eq domain'
wait '#'
sendln 'access-list OUTSIDE_IN extended permit tcp any object JUMP-SVR eq ssh'
wait '#'
sendln 'access-list OUTSIDE_IN extended deny ip any any log'
wait '#'

; Bind ACLs to Interfaces
sendln 'access-group INSIDE_IN in interface inside'
wait '#'
sendln 'access-group SERVER_IN in interface server'
wait '#'
sendln 'access-group DMZ_IN in interface dmz'
wait '#'
sendln 'access-group OUTSIDE_IN in interface outside'
wait '#'
sendln 'access-group OUTSIDE_IN in interface wan-backup'
wait '#'

; 12. Modular Policy Framework (MPF) - Stateful ICMP Inspection
sendln 'policy-map global_policy'
wait '#'
sendln 'class inspection_default'
wait '#'
sendln 'inspect icmp'
wait '#'
sendln 'inspect icmp error'
wait '#'
sendln 'exit'
wait '#'
sendln 'exit'
wait '#'

; 13. AAA, SSH, NTP & Syslog over OOB Management
sendln 'aaa-server TACACS protocol tacacs+'
wait '#'
sendln 'aaa-server TACACS (management) host 172.16.0.44'
wait '#'
sendln 'key bigBoy@ServerPassword1'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa-server TACACS (management) host 172.16.0.45'
wait '#'
sendln 'key bigBoy@ServerPassword2'
wait '#'
sendln 'exit'
wait '#'

sendln 'aaa authentication ssh console TACACS LOCAL'
wait '#'
sendln 'aaa authentication enable console TACACS LOCAL'
wait '#'
; WARNING: 'aaa authorization command TACACS LOCAL' is DISABLED until the TACACS
; servers (172.16.0.44 / .45 = VM102/VM106) are built and verified reachable.
; With TACACS down, per-command authorization falls back to LOCAL, which denies
; even basic commands (exit, show) and LOCKS YOU OUT of the ASA. Only enable this
; AFTER TACACS is confirmed working, and keep a console session open as a safety
; net when you do. Re-enable with:
;   sendln 'aaa authorization command TACACS LOCAL'
; sendln 'aaa authorization command TACACS LOCAL'
; wait '#'
sendln 'aaa accounting command TACACS'
wait '#'

sendln 'ssh 172.16.0.44 255.255.255.255 management'
wait '#'
sendln 'ssh 172.16.0.45 255.255.255.255 management'
wait '#'
sendln 'ssh timeout 10'
wait '#'
sendln 'no http server enable'
wait '#'

sendln 'ntp server 172.16.0.44 source management prefer'
wait '#'
sendln 'ntp server 172.16.0.45 source management'
wait '#'

sendln 'logging enable'
wait '#'
sendln 'logging timestamp'
wait '#'
sendln 'logging trap informational'
wait '#'
; NOTE: "logging host interface conflicts with route table entry" warning is
; EXPECTED. The syslog hosts .44/.45 sit in the management interface's own
; connected subnet (172.16.0.32/28), so pinning the 'management' interface is
; redundant from the ASA's view - but we keep it explicit to guarantee OOB
; isolation and prevent syslog ever egressing a data interface.
sendln 'logging host management 172.16.0.44'
wait '#'
sendln 'logging host management 172.16.0.45'
wait '#'

; End configuration
sendln 'end'
wait '#'